## local.properties Template
## Copy this file to local.properties and fill in your values
## NEVER commit local.properties to version control!

# Android SDK location (auto-generated by Android Studio)
sdk.dir=/Users/YOUR_USERNAME/Library/Android/sdk

# Release signing configuration
# Store your keystore in a secure location OUTSIDE the project directory
RELEASE_STORE_FILE=/Users/YOUR_USERNAME/.android/keystores/audion-release.jks
RELEASE_STORE_PASSWORD=your_strong_store_password
RELEASE_KEY_ALIAS=audion-release
RELEASE_KEY_PASSWORD=your_strong_key_password

# Security Notes:
# 1. Use strong, unique passwords (minimum 20 characters recommended)
# 2. Store keystore backup in multiple secure locations
# 3. If keystore is lost, you cannot update your app on Play Store
# 4. Never share keystore or passwords
# 5. For CI/CD, use encrypted environment variables instead
