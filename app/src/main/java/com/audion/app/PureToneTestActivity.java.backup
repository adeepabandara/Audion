    private volatile boolean isAdvancing = false; // Add flag to prevent double navigation
    
    /**
     * CRITICAL FIX: Check calibration status to determine proper navigation after LEFT ear completion
     * This prevents the infinite loop by intelligently routing to calibration or results
     */
    private void checkCalibrationStatusAndNavigate() {
        new Thread(() -> {
            try {
                AppDatabase db = AppDatabase.getInstance(PureToneTestActivity.this);
                com.example.audion.data.CalibrationProfileDao calibrationProfileDao = db.calibrationProfileDao();
                
                // Check if calibration profiles exist for both ears
                com.example.audion.data.CalibrationProfileEntity rightEarCalibration = 
                    calibrationProfileDao.getLatestProfileForEar(userId, "RIGHT", hearingProfileId);
                com.example.audion.data.CalibrationProfileEntity leftEarCalibration = 
                    calibrationProfileDao.getLatestProfileForEar(userId, "LEFT", hearingProfileId);
                
                boolean hasRightCalibration = (rightEarCalibration != null);
                boolean hasLeftCalibration = (leftEarCalibration != null);
                
                Log.i("NavigationFlow", "=== CALIBRATION STATUS CHECK ===");
                Log.i("NavigationFlow", "User ID: " + userId + ", Hearing Profile ID: " + hearingProfileId);
                Log.i("NavigationFlow", "Right ear calibration exists: " + hasRightCalibration);
                Log.i("NavigationFlow", "Left ear calibration exists: " + hasLeftCalibration);
                Log.i("NavigationFlow", "================================");
                
                runOnUiThread(() -> {
                    if (!hasRightCalibration && !hasLeftCalibration) {
                        // No calibration done yet - start with LEFT ear calibration
                        Log.i("NavigationFlow", "No calibration found, starting with LEFT ear calibration");
                        Toast.makeText(this, "✅ Pure tone tests complete! Starting calibration...", Toast.LENGTH_LONG).show();
                        
                        Intent calibrationIntent = new Intent(this, CalibrationInstructionActivity.class);
                        calibrationIntent.putExtra("EAR", "LEFT");
                        calibrationIntent.putExtra("USER_ID", userId);
                        calibrationIntent.putExtra("HEARING_PROFILE_ID", hearingProfileId);
                        startActivity(calibrationIntent);
                        overridePendingTransition(R.anim.smooth_fade_in, R.anim.smooth_fade_out);
                        finish();
                    } else if (hasRightCalibration && hasLeftCalibration) {
                        // Both calibrations complete - go to results
                        Log.i("NavigationFlow", "All tests completed, navigating to TestResultsActivity");
                        Toast.makeText(this, "🎉 All tests complete! Viewing results...", Toast.LENGTH_LONG).show();
                        
                        Intent resultsIntent = new Intent(this, TestResultsActivity.class);
                        resultsIntent.putExtra("USER_ID", userId);
                        resultsIntent.putExtra("HEARING_PROFILE_ID", hearingProfileId);
                        startActivity(resultsIntent);
                        overridePendingTransition(R.anim.smooth_fade_in, R.anim.smooth_fade_out);
                        finish();
                    } else {
                        // Partial calibration - complete the missing ear
                        String missingEar = hasLeftCalibration ? "RIGHT" : "LEFT";
                        Log.i("NavigationFlow", "Partial calibration found, completing " + missingEar + " ear");
                        Toast.makeText(this, "✅ Pure tone tests complete! Finishing " + missingEar.toLowerCase() + " ear calibration...", Toast.LENGTH_LONG).show();
                        
                        Intent calibrationIntent = new Intent(this, CalibrationInstructionActivity.class);
                        calibrationIntent.putExtra("EAR", missingEar);
                        calibrationIntent.putExtra("USER_ID", userId);
                        calibrationIntent.putExtra("HEARING_PROFILE_ID", hearingProfileId);
                        startActivity(calibrationIntent);
                        overridePendingTransition(R.anim.smooth_fade_in, R.anim.smooth_fade_out);
                        finish();
                    }
                });
                
            } catch (Exception e) {
                Log.e("NavigationFlow", "Error checking calibration status: " + e.getMessage(), e);
                runOnUiThread(() -> {
                    // Fallback - go to results to prevent infinite loop
                    Toast.makeText(this, "⚠️ Navigation error - proceeding to results", Toast.LENGTH_SHORT).show();
                    Intent resultsIntent = new Intent(this, TestResultsActivity.class);
                    resultsIntent.putExtra("USER_ID", userId);
                    resultsIntent.putExtra("HEARING_PROFILE_ID", hearingProfileId);
                    startActivity(resultsIntent);
                    overridePendingTransition(R.anim.smooth_fade_in, R.anim.smooth_fade_out);
                    finish();
                });
            }
        }).start();
    }
    
    private void advanceToNextFrequencyOrComplete() {
        // Prevent multiple simultaneous calls
        if (isAdvancing) {
            Log.d("PureToneTest", "advanceToNextFrequencyOrComplete already in progress, ignoring call");
            return;
        }
        
        isAdvancing = true;
        Log.d("PureToneTest", "advanceToNextFrequencyOrComplete called - currentFreqIndex: " + currentFreqIndex + ", ear: " + currentEar);
        
        try {
            currentFreqIndex++;
            
            // Update stepper progress when advancing
            updateStepperProgress();
            
            if (currentFreqIndex >= frequencies.length) {
                Log.i("NavigationFlow", "All frequencies completed for " + currentEar + " ear, determining next step");
                
                // Automatically navigate to next step instead of showing completion UI
                if ("RIGHT".equals(currentEar)) {
                    // Right ear pure tone test done, proceed to left ear instruction
                    Log.i("NavigationFlow", "Right ear pure tone test completed, navigating to left ear instruction");
                    Toast.makeText(this, "✅ Right ear test complete! Now testing left ear...", Toast.LENGTH_SHORT).show();
                    Intent leftEarIntent = new Intent(this, LeftEarInstructionActivity.class);
                    leftEarIntent.putExtra("USER_ID", userId);
                    leftEarIntent.putExtra("HEARING_PROFILE_ID", hearingProfileId);
                    startActivity(leftEarIntent);
                    overridePendingTransition(R.anim.smooth_fade_in, R.anim.smooth_fade_out);
                    finish();
                } else {
                    // Both ears pure tone tests completed - check if calibration is needed
                    Log.i("NavigationFlow", "Both ears pure tone tests completed, checking calibration status");
                    checkCalibrationStatusAndNavigate();
                }
                return;
            }
            
            Log.d("PureToneTest", "Moving to next frequency - index: " + currentFreqIndex + ", frequency: " + frequencies[currentFreqIndex] + "Hz");
            progressBar.setProgress(0);
            
            // Automatically start the next frequency after a brief delay
            new android.os.Handler().postDelayed(() -> {
                startRampForCurrentFrequency();
            }, 1000); // 1 second delay
            
        } catch (Exception e) {
            Log.e("PureToneTest", "Error in advanceToNextFrequencyOrComplete", e);
            Toast.makeText(this, "Navigation error: " + e.getMessage(), Toast.LENGTH_SHORT).show();
        } finally {
            isAdvancing = false;
        }
    }
    
    private void advanceToNextFrequency() {
        // Prevent multiple simultaneous calls
        if (isAdvancing) {
            Log.d("PureToneTest", "advanceToNextFrequency already in progress, ignoring call");
            return;
        }
        
        isAdvancing = true;
        Log.d("PureToneTest", "advanceToNextFrequency called - currentFreqIndex: " + currentFreqIndex + ", ear: " + currentEar);
        
        try {
            currentFreqIndex++;
            
            // Update stepper progress when advancing
            updateStepperProgress();
            
            if (currentFreqIndex >= frequencies.length) {
                Log.d("PureToneTest", "All frequencies completed for " + currentEar + " ear");
                
                Toast.makeText(this,
                    (currentEar.equalsIgnoreCase("LEFT") ? "Left Ear" : "Right Ear") + " Pure Tone Test Complete!",
                    Toast.LENGTH_SHORT
                ).show();
                
                // Show completion UI with Start again button
                showCompletionUI();
                
                // For now, don't automatically navigate - let user click Start again
                // TODO: Implement Start again button functionality to navigate to next step or restart
                return;
            }
            
            Log.d("PureToneTest", "Moving to next frequency - index: " + currentFreqIndex + ", frequency: " + frequencies[currentFreqIndex] + "Hz");
            progressBar.setProgress(0);
            showStartUI();
            
        } catch (Exception e) {
            Log.e("PureToneTest", "Error in advanceToNextFrequency", e);
            Toast.makeText(this, "Navigation error: " + e.getMessage(), Toast.LENGTH_SHORT).show();
        } finally {
            isAdvancing = false;
        }
    }

