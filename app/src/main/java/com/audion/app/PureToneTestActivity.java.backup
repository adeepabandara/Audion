                            if (buttonHeard != null) {
                                buttonHeard.setEnabled(true);
                                buttonHeard.setAlpha(1.0f);
                            }
                            if (buttonNotHeard != null) {
                                buttonNotHeard.setEnabled(true);
                                buttonNotHeard.setAlpha(1.0f);
                            }
                        });
                    }
                    
                    @Override
                    public void onToneCompleted(int frequencyHz, int levelDbHL) {
                        Log.d("PureToneTest", "ANSI tone completed: " + frequencyHz + "Hz at " + levelDbHL + "dB HL");
                        // Keep buttons enabled for user response
                    }
                    
                    @Override
                    public void onToneError(String error) {
                        Log.e("PureToneTest", "ANSI tone error: " + error);
                        runOnUiThread(() -> {
                            Toast.makeText(PureToneTestActivity.this, "Audio error: " + error, Toast.LENGTH_SHORT).show();
                            // Fall back to legacy if audio fails
                            useANSITesting = false;
                            startLegacyRampTest();
                        });
                    }
                });
                
                retsplTable = new RETSPLTable();
                audiogramResults = new HashMap<>();
                Log.d("PureToneTest", "ANSI audiometry engine initialized for " + currentEar + " ear");
            } catch (Exception e) {
                Log.e("PureToneTest", "Failed to initialize ANSI engine: " + e.getMessage(), e);
                useANSITesting = false;
                audiometryEngine = null;
                Toast.makeText(this, "Audio system error - using fallback mode", Toast.LENGTH_SHORT).show();
            }
        }

        buttonStart.setOnClickListener(v -> {
            // Add button press animation
            animateButtonPress(v);
            
            String buttonText = buttonStart.getText().toString();
            Log.d("PureToneTest", "▶️ START BUTTON CLICKED - Text: " + buttonText);
            
            try {
                if ("START TEST".equals(buttonText) && !testStarted) {
                    // Initial test start - begin clinical hearing test
                    Log.d("PureToneTest", "Starting clinical pure tone test for " + currentEar + " ear");
                    Toast.makeText(this, "🎧 Starting clinical hearing test for " + currentEar + " ear", Toast.LENGTH_SHORT).show();
                    
                    testStarted = true;
                    currentFreqIndex = 0;
                    
                    // Update UI
                    runOnUiThread(() -> {
                        buttonStart.setVisibility(View.GONE);
                        buttonHeard.setVisibility(View.VISIBLE);
