            // Add button press animation
            animateButtonPress(v);
            
            Log.d("PureToneTest", "CLINICAL: User heard tone at " + currentThresholdLevel + "dB HL - " + 
                  frequencies[currentFreqIndex] + "Hz, ear: " + currentEar);
            
            // Stop current tone immediately
            if (audioGenerator != null) {
                audioGenerator.stopTone();
            }
            
            // Cancel timeout
            if (timeoutHandler != null) {
                timeoutHandler.removeCallbacksAndMessages(null);
            }
            
            // Process clinical response
            processClinicalResponse(true);
        });
        
        // Initialize clinical components
        thresholdResults = new HashMap<>();
        audioGenerator = new com.example.audion.audio.ClinicalAudioGenerator();
        timeoutHandler = new android.os.Handler();

        // Initialize UI
        setupClinicalUI();
        
        Log.d("PureToneTest", "=== Clinical PureToneTestActivity onCreate COMPLETED ===");
        
        } catch (Exception e) {
            Log.e("PureToneTest", "Error in PureToneTestActivity onCreate", e);
            // Handle the error gracefully
            Toast.makeText(this, "Failed to initialize pure tone test", Toast.LENGTH_LONG).show();
            finish();
        }
    }
    
    /**
     * CLINICAL METHODOLOGY: Process user response using Hughson-Westlake procedure
     * @param heard true if user heard the tone, false if timeout (no response)
     */
    private void processClinicalResponse(boolean heard) {
        int frequency = frequencies[currentFreqIndex];
        
        Log.d("PureToneTest", "CLINICAL: Processing response - freq: " + frequency + "Hz, level: " + 
              currentThresholdLevel + "dB HL, heard: " + heard);
        
        if (heard) {
            // User heard the tone - threshold is at or below this level
            consecutiveResponses++;
            consecutiveNoResponses = 0;
            
            // Decrease level by 10 dB for next presentation (Hughson-Westlake)
            currentThresholdLevel -= 10;
            
            // Safety limit - don't go below -10 dB HL
            if (currentThresholdLevel < -10) {
                // Threshold found at minimum testable level
                recordThresholdAndAdvance(-10);
                return;
            }
            
        } else {
            // No response (timeout) - threshold is above this level
            consecutiveNoResponses++;
            consecutiveResponses = 0;
            
            // Check if we found threshold (ascending method)
            if (consecutiveNoResponses >= 2 && currentThresholdLevel > 0) {
                // Found threshold - record previous heard level
                int threshold = currentThresholdLevel + 10; // Last heard level
                recordThresholdAndAdvance(Math.min(threshold, 120)); // Cap at 120 dB HL
                return;
            }
            
            // Increase level by 5 dB for next presentation
            currentThresholdLevel += 5;
            
            // Safety limit - don't exceed 120 dB HL
            if (currentThresholdLevel > 120) {
                // No response at maximum level - record as "No Response"
                recordThresholdAndAdvance(125); // 125 indicates no response
                return;
            }
        }
        
        // Continue testing at new level
        presentNextTone();
    }
    
    /**
     * Present the next clinical tone with timeout
     */
    private void presentNextTone() {
        int frequency = frequencies[currentFreqIndex];
        
        runOnUiThread(() -> {
            // Update UI
            frequencyDisplay.setText(frequency + " Hz");
            thresholdDisplay.setText("Level: " + currentThresholdLevel + " dB HL");
            instructionText.setText("Press 'Heard Tone' when you hear the sound");
            
            // Disable button during tone presentation
            buttonHeard.setEnabled(false);
            buttonHeard.setAlpha(0.5f);
        });
        
        Log.d("PureToneTest", "CLINICAL: Presenting tone - " + frequency + "Hz at " + 
              currentThresholdLevel + "dB HL");
        
        // Present tone with clinical parameters
        audioGenerator.playClinicalTone(frequency, TONE_DURATION_MS, currentThresholdLevel, 
                                      false, // false = dB HL (audiometry)
                                      new com.example.audion.audio.ClinicalAudioGenerator.ToneCompletionCallback() {
            @Override
            public void onToneStarted() {
                runOnUiThread(() -> {
                    // Enable response button
                    buttonHeard.setEnabled(true);
                    buttonHeard.setAlpha(1.0f);
                    
                    // Start timeout timer
                    timeoutHandler.postDelayed(() -> {
                        // Timeout - no response
                        Log.d("PureToneTest", "CLINICAL: Timeout - no response at " + 
                              currentThresholdLevel + "dB HL");
                        processClinicalResponse(false);
                    }, TIMEOUT_DURATION_MS);
                });
            }
            
            @Override
            public void onToneCompleted() {
                // Tone finished playing normally
            }
            
            @Override
            public void onToneStopped() {
                // Tone was stopped by user response - good
            }
            
            @Override
            public void onToneError(String error) {
                Log.e("PureToneTest", "Clinical tone error: " + error);
                runOnUiThread(() -> {
                    Toast.makeText(PureToneTestActivity.this, "Audio error: " + error, Toast.LENGTH_SHORT).show();
                    // Continue to next frequency to avoid getting stuck
                    advanceToNextFrequency();
                });
            }
        });
    }
    
    /**
     * Record threshold and advance to next frequency or complete test
     */
    private void recordThresholdAndAdvance(int thresholdDbHL) {
        int frequency = frequencies[currentFreqIndex];
        
        // Store threshold result
        thresholdResults.put(frequency, thresholdDbHL);
        
        Log.i("PureToneTest", "CLINICAL: Threshold found for " + frequency + "Hz: " + thresholdDbHL + "dB HL");
        
        // Save to database
        saveThresholdResult(frequency, thresholdDbHL);
        
        // Reset for next frequency
        currentThresholdLevel = 30; // Start next frequency at 30 dB HL
        consecutiveResponses = 0;
        consecutiveNoResponses = 0;
        thresholdFound = false;
        
        // Advance to next frequency
        advanceToNextFrequency();
    }
    
    /**
     * Save threshold result to database
     */
    private void saveThresholdResult(int frequency, int thresholdDbHL) {
        new Thread(() -> {
            try {
                AppDatabase db = AppDatabase.getInstance(this);
                AudiometryResultDao audiometryDao = db.audiometryResultDao();
                
                // Create audiometry result
                // Calculate approximate SPL from HL (simplified conversion)
                float thresholdDbSPL = thresholdDbHL + 20.0f; // Rough approximation for now
                
                AudiometryResult result = new AudiometryResult(
                    userId,
                    currentEar,
                    frequency,
                    thresholdDbHL,
                    thresholdDbSPL,
                    true, // isReliable - assume true for now
                    3,    // reversalCount - default
                    hearingProfileId
                );
                
                // Delete any existing result for this combination to prevent duplicates
                audiometryDao.deleteResult(userId, hearingProfileId, currentEar, frequency);
                
                // Insert new result
                audiometryDao.insert(result);
                
                Log.d("PureToneTest", "CLINICAL: Saved threshold - " + frequency + "Hz: " + 
                      thresholdDbHL + "dB HL for " + currentEar + " ear");
                
            } catch (Exception e) {
                Log.e("PureToneTest", "Error saving threshold result: " + e.getMessage(), e);
            }
        }).start();
    }
    
    /**
     * Set up clinical audiometry UI
     */
    private void setupClinicalUI() {
