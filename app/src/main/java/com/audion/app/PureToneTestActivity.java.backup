        audiometryResultDao = AppDatabase.getInstance(this).audiometryResultDao();
        
        // Initialize clinical audio generator
        audioGenerator = new ClinicalAudioGenerator();
        Log.d("PureToneTest", "Initialized Clinical Pure Tone Testing mode");
                
                // Set up audio playback listener for ANSI engine
                audiometryEngine.setAudioPlaybackListener(new ANSI_AudiometryEngine.AudioPlaybackListener() {
                    @Override
                    public void onToneStarted(int frequencyHz, int levelDbHL) {
                        Log.d("PureToneTest", "ANSI tone started: " + frequencyHz + "Hz at " + levelDbHL + "dB HL");
                        runOnUiThread(() -> {
