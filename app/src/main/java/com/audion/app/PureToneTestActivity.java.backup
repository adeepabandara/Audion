    private void showANSITestingUI() {
        // Show both buttons for ANSI testing (user responds to each tone)
        buttonHeard.setVisibility(View.VISIBLE);
        buttonNotHeard.setVisibility(View.VISIBLE);
        buttonStart.setVisibility(View.GONE);
        
        // Update button text for ANSI testing
        buttonHeard.setText("I Heard It");
        buttonNotHeard.setText("I Didn't Hear It");
    }
    
    private void saveANSIResultAndAdvance(int frequency, int thresholdDbHL, float thresholdDbSPL) {
        new Thread(() -> {
            try {
                // Check if we have a reliable threshold
                boolean isReliable = audiometryEngine.isTestReliable(currentEar, frequency);
                int reversalCount = 3; // Default for completed test
                
                // Create new ANSI audiometry result
                AudiometryResult ansiResult = new AudiometryResult(
                    userId, currentEar, frequency, 
                    (float) thresholdDbHL, thresholdDbSPL, 
                    isReliable, reversalCount, hearingProfileId
                );
                
                // Save to new audiometry results table
                audiometryResultDao.insert(ansiResult);
                
                // Also save to legacy table for compatibility
                HearingTestResult legacyResult = new HearingTestResult(
                    userId, currentEar, frequency, lastAmplitudeStep, hearingProfileId
                );
                hearingTestResultDao.insert(legacyResult);
                
                Log.d("PureToneTest", "ANSI result saved: " + frequency + "Hz = " + thresholdDbHL + "dB HL");
                
                runOnUiThread(this::advanceToNextFrequencyOrComplete);
                
            } catch (Exception e) {
                Log.e("PureToneTest", "Error saving ANSI result: " + e.getMessage());
                runOnUiThread(() -> {
                    Toast.makeText(PureToneTestActivity.this, "Error saving test result", Toast.LENGTH_SHORT).show();
                    advanceToNextFrequencyOrComplete();
                });
            }
        }).start();
    }
    
    private void checkANSITestCompletion() {
        new Thread(() -> {
            try {
                final int freq = frequencies[currentFreqIndex];
                
                // Check if the current test is complete
                if (audiometryEngine.isThresholdComplete(currentEar, freq)) {
                    // Get the threshold result
                    int thresholdDbHL = audiometryEngine.getThreshold(currentEar, freq);
                    
                    Log.d("PureToneTest", "ANSI threshold determined: " + freq + "Hz = " + thresholdDbHL + "dB HL");
                    
                    // Store result in audiogram
                    audiogramResults.put(freq, (float) thresholdDbHL);
                    
                    // Convert to amplitude step for legacy database compatibility
                    RETSPLTable.TransducerType transducerType = RETSPLTable.TransducerType.INSERT;
                    float thresholdDbSPL = RETSPLTable.convertHLtoSPL(freq, (float) thresholdDbHL, transducerType);
                    lastAmplitudeStep = (int) ((thresholdDbSPL + 10) / 110 * 100); // Convert to 0-100 scale
                    
                    runOnUiThread(() -> {
                        progressBar.setProgress(100);
                        // Save ANSI results to new database table
                        saveANSIResultAndAdvance(freq, thresholdDbHL, thresholdDbSPL);
                    });
                }
                
            } catch (Exception e) {
                Log.e("PureToneTest", "Error checking ANSI test completion: " + e.getMessage());
                runOnUiThread(() -> {
                    Toast.makeText(PureToneTestActivity.this, "Test error occurred", Toast.LENGTH_SHORT).show();
                    // Continue with next frequency to avoid getting stuck
                    advanceToNextFrequencyOrComplete();
                });
            }
        }).start();
    }
    
