    private void checkAudioDevice() {
        AudioManager audioManager = (AudioManager) getSystemService(AUDIO_SERVICE);
        if (audioManager == null) {
            Toast.makeText(this, "❌ AudioManager not available", Toast.LENGTH_LONG).show();
            return;
        }

        // Check system volume
        int currentVolume = audioManager.getStreamVolume(AudioManager.STREAM_MUSIC);
        int maxVolume = audioManager.getStreamMaxVolume(AudioManager.STREAM_MUSIC);
        float volumePercent = (currentVolume * 100f) / maxVolume;
        
        Log.d("PureToneTest", "🔊 System volume: " + currentVolume + "/" + maxVolume + " (" + volumePercent + "%)");
        
        if (volumePercent < 50) {
            Toast.makeText(this, "⚠️ Media volume is low (" + (int)volumePercent + "%). Please increase volume for hearing test.", Toast.LENGTH_LONG).show();
        }
        
        AudioDeviceInfo[] devices = audioManager.getDevices(AudioManager.GET_DEVICES_OUTPUTS);
        boolean hasWiredHeadset = false;
        boolean hasBluetoothA2dp = false;
        
        for (AudioDeviceInfo device : devices) {
            switch (device.getType()) {
                case AudioDeviceInfo.TYPE_WIRED_HEADSET:
                case AudioDeviceInfo.TYPE_WIRED_HEADPHONES:
                    hasWiredHeadset = true;
                    Log.d("PureToneTest", "Wired headphones detected: " + device.getProductName());
                    break;
                case AudioDeviceInfo.TYPE_BLUETOOTH_A2DP:
                    hasBluetoothA2dp = true;
                    Log.d("PureToneTest", "Bluetooth headphones detected: " + device.getProductName());
                    break;
            }
        }
        
        if (!hasWiredHeadset && !hasBluetoothA2dp) {
            runOnUiThread(() -> {
                Toast.makeText(this, "⚠️ For best results, please connect headphones or earbuds", Toast.LENGTH_LONG).show();
                // Play system beep to test audio
                try {
                    android.media.ToneGenerator toneGen = new android.media.ToneGenerator(AudioManager.STREAM_MUSIC, 80);
                    toneGen.startTone(android.media.ToneGenerator.TONE_PROP_BEEP, 500);
                    toneGen.release();
                    Log.d("PureToneTest", "🔔 System beep test played");
                } catch (Exception e) {
                    Log.e("PureToneTest", "❌ System beep failed: " + e.getMessage());
                }
            });
        }
    }
    
    
    @Override
    protected void onDestroy() {
        Log.d("PureToneTest", "=== Clinical PureToneTestActivity onDestroy - currentEar: " + currentEar + " ===");
        
        // Clean up clinical audio resources
        if (audioGenerator != null) {
            audioGenerator.release();
            audioGenerator = null;
        }
        
        // Clean up timeout handler
        if (timeoutHandler != null) {
            timeoutHandler.removeCallbacksAndMessages(null);
            timeoutHandler = null;
        }
        
        super.onDestroy();
        
        // Clean up ANSI audiometry engine
        if (audiometryEngine != null) {
            try {
                audiometryEngine.release();
                Log.d("PureToneTest", "ANSI audiometry engine cleaned up");
            } catch (Exception e) {
                Log.e("PureToneTest", "Error cleaning up ANSI engine: " + e.getMessage());
            }
        }
    }
    
    private void setupSimplifiedUI() {
        // Find UI elements
        TextView title = findViewById(R.id.title);
        TextView earLabel = findViewById(R.id.earLabel);
        TextView progressText = findViewById(R.id.progressText);
        TextView frequencyText = findViewById(R.id.frequencyText);
        ImageView earImage = findViewById(R.id.imageViewEar);
        progressBar = findViewById(R.id.progressBar);
        buttonStart = findViewById(R.id.buttonStart);
        buttonHeard = findViewById(R.id.buttonHeard);
        buttonNotHeard = findViewById(R.id.buttonNotHeard);
        LinearLayout responseButtonsRow = findViewById(R.id.responseButtonsRow);

        // Set up title and ear information
        if (title != null) {
            title.setText("Pure Tone Test");
        }
        if (earLabel != null) {
            earLabel.setText(currentEar.equalsIgnoreCase("LEFT") ? "Left Ear" : "Right Ear");
        }

        // Set ear image
        if (earImage != null) {
            try {
                if ("LEFT".equalsIgnoreCase(currentEar)) {
                    earImage.setImageResource(R.drawable.left_ear);
                } else {
                    earImage.setImageResource(R.drawable.right_ear);
                }
            } catch (Exception e) {
                Log.w("PureToneTest", "Could not set ear image: " + e.getMessage());
            }
        }

        // Initialize progress display
        if (progressText != null) {
            progressText.setText("Test 1 of " + frequencies.length);
        }
        if (frequencyText != null) {
            frequencyText.setText(frequencies[0] + " Hz");
        }

        // Set up progress bar
        if (progressBar != null) {
            progressBar.setMax(100);
            progressBar.setProgress(0);
        }

        // Hide response buttons initially
        if (responseButtonsRow != null) {
            responseButtonsRow.setVisibility(View.GONE);
        }

        // Verify all essential UI elements exist
        if (progressBar == null || buttonStart == null || buttonHeard == null || buttonNotHeard == null) {
            Log.e("PureToneTest", "One or more UI elements not found in simplified layout");
            Toast.makeText(this, "UI initialization failed - missing buttons", Toast.LENGTH_LONG).show();
            finish();
            return;
        }

        Log.d("PureToneTest", "Simplified UI setup completed successfully");
    }
}
