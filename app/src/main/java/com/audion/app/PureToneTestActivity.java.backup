    /**
     * Start the audiometry test using ANSI engine if enabled, otherwise fallback to legacy
     */
    /**
     * Start clinical hearing test using standard frequencies
     */
    private void startClinicalTest() {
        Log.d("PureToneTest", "CLINICAL: Starting test with frequencies: " + java.util.Arrays.toString(frequencies));
        
        if (currentFreqIndex >= frequencies.length) {
            // All frequencies complete for this ear
            completeEarTest();
            return;
        }
        
        // Start with first frequency at 30 dB HL
        currentThresholdLevel = 30;
        consecutiveResponses = 0;
        consecutiveNoResponses = 0;
        thresholdFound = false;
        
        // Present first tone
        presentNextTone();
    }
    

    
    /**
     * Complete test for current ear and navigate appropriately
     */
    private void completeEarTest() {
        Log.i("PureToneTest", "CLINICAL: Completed " + currentEar + " ear test");
        
        runOnUiThread(() -> {
            // Show completion message
            String message = "✅ " + currentEar + " ear test complete!";
            Toast.makeText(this, message, Toast.LENGTH_SHORT).show();
            
            // Update UI
            instructionText.setText("Test completed for " + currentEar + " ear");
            buttonHeard.setVisibility(View.GONE);
            buttonStart.setText("Continue");
            buttonStart.setVisibility(View.VISIBLE);
        });
        
        // Navigate to next step
        if ("RIGHT".equals(currentEar)) {
            // Navigate to LEFT ear test
            new android.os.Handler().postDelayed(() -> {
                Intent leftEarIntent = new Intent(this, LeftEarInstructionActivity.class);
                leftEarIntent.putExtra("USER_ID", userId);
                leftEarIntent.putExtra("HEARING_PROFILE_ID", hearingProfileId);
                startActivity(leftEarIntent);
                finish();
            }, 2000);
        } else {
            // Both ears complete - check calibration status
            new android.os.Handler().postDelayed(() -> {
                checkCalibrationStatusAndNavigate();
            }, 2000);
        }
    }

    private void startANSITestOrLegacy() {
        Log.d("PureToneTest", "startANSITestOrLegacy called - useANSITesting: " + useANSITesting + ", ear: " + currentEar);
        
        if (!testStarted) {
            Log.e("PureToneTest", "startANSITestOrLegacy called but test not started - blocking");
            return;
        }
        
        try {
            if (useANSITesting && audiometryEngine != null) {
                // Use ANSI audiometry engine for clinical testing
                int testFrequency = frequencies[currentFreqIndex];
                Log.d("PureToneTest", "Starting ANSI audiometry test for frequency: " + testFrequency + "Hz");
                
                // Validate frequency before starting test
                Log.d("PureToneTest", "Validating frequency " + testFrequency + "Hz with ANSI engine");
                
                // Show test UI
                showResponseUI();
                
                // Initialize ANSI test for current frequency using correct method name
                boolean started = audiometryEngine.startThresholdTest(currentEar, testFrequency);
                
                if (started) {
                    Log.i("PureToneTest", "ANSI threshold test started successfully for " + testFrequency + "Hz");
                } else {
                    Log.w("PureToneTest", "ANSI threshold test failed to start for " + testFrequency + "Hz, falling back to legacy");
                    Toast.makeText(this, "Frequency " + testFrequency + "Hz not supported by ANSI engine, using legacy test", Toast.LENGTH_SHORT).show();
                    startRampForCurrentFrequency();
                }
                
            } else {
                // Fallback to legacy ramp test
                Log.d("PureToneTest", "Starting legacy ramp test for frequency: " + frequencies[currentFreqIndex] + "Hz");
                startRampForCurrentFrequency();
            }
        } catch (Exception e) {
            Log.e("PureToneTest", "Error in startANSITestOrLegacy", e);
            Toast.makeText(this, "Error starting test", Toast.LENGTH_SHORT).show();
        }
    }
    
    private void initializeSteppers() {
        // Check if we're using the simplified layout (no steppers)
        if (stepImages == null || stepImages.length == 0) {
            Log.d("PureToneTest", "Using simplified layout - no steppers to initialize");
            return;
        }
        
        // Reset all steppers to inactive state (legacy layout)
        for (int i = 0; i < stepImages.length; i++) {
            if (stepImages[i] != null) {
                try {
                    stepImages[i].setImageResource(R.drawable.circle_inactive);
                } catch (Exception e) {
                    Log.w("PureToneTest", "Could not set stepper image: " + e.getMessage());
                }
            }
            if (stepTexts[i] != null) {
                try {
                    stepTexts[i].setTextColor(ContextCompat.getColor(this, R.color.text_inactive));
                } catch (Exception e) {
                    Log.w("PureToneTest", "Could not set stepper text color: " + e.getMessage());
                }
            }
        }
        
        // Mark current step as active
        updateStepperProgress();
    }
    
    private void updateStepperProgress() {
        // Check if we're using the simplified layout (no steppers)
        if (stepImages == null || stepImages.length == 0) {
            // Update simplified layout progress indicators
            updateSimplifiedProgress();
            return;
        }
        
        // Update stepper visual state based on current frequency index (1:1 mapping) - legacy layout
        for (int i = 0; i < stepImages.length && i < stepTexts.length; i++) {
            if (stepImages[i] != null && stepTexts[i] != null) {
                try {
                    if (i < currentFreqIndex) {
                        // Completed step - use primary color
                        stepImages[i].setImageResource(R.drawable.circle_completed);
                        stepTexts[i].setTextColor(ContextCompat.getColor(this, android.R.color.white));
                    } else if (i == currentFreqIndex) {
                        // Current active step - use primary color
                        stepImages[i].setImageResource(R.drawable.circle_active);
                        stepTexts[i].setTextColor(ContextCompat.getColor(this, R.color.primary));
                    } else {
                        // Future step - inactive
                        stepImages[i].setImageResource(R.drawable.circle_inactive);
                        stepTexts[i].setTextColor(ContextCompat.getColor(this, R.color.text_inactive));
                    }
                } catch (Exception e) {
                    Log.w("PureToneTest", "Could not update stepper " + i + ": " + e.getMessage());
                }
            }
        }
    }
    
    private void updateSimplifiedProgress() {
        // Update progress for simplified layout
        TextView progressText = findViewById(R.id.progressText);
        TextView frequencyText = findViewById(R.id.frequencyText);
        
        if (progressText != null) {
            progressText.setText("Test " + (currentFreqIndex + 1) + " of " + frequencies.length);
        }
        
        if (frequencyText != null && currentFreqIndex < frequencies.length) {
            frequencyText.setText(frequencies[currentFreqIndex] + " Hz");
        }
    }

    private void startRampForCurrentFrequency() {
        Log.d("PureToneTest", "startRampForCurrentFrequency called for " + currentEar + " ear, frequency index: " + currentFreqIndex);
        Log.d("PureToneTest", "useANSITesting = " + useANSITesting + ", audiometryEngine = " + (audiometryEngine != null ? "initialized" : "null"));
        
        // Add safety check for frequency index
        if (currentFreqIndex < 0 || currentFreqIndex >= frequencies.length) {
            Log.e("PureToneTest", "Invalid frequency index: " + currentFreqIndex + ", resetting to 0");
            currentFreqIndex = 0;
        }
        
        try {
            if (useANSITesting && audiometryEngine != null) {
                Log.d("PureToneTest", "Starting ANSI threshold test...");
                startANSIThresholdTest();
            } else {
                Log.d("PureToneTest", "Starting legacy ramp test...");
                startLegacyRampTest();
            }
        } catch (Exception e) {
            Log.e("PureToneTest", "Error in startRampForCurrentFrequency: " + e.getMessage(), e);
            Toast.makeText(this, "Error starting test: " + e.getMessage(), Toast.LENGTH_LONG).show();
        }
    }
    
    private void startANSIThresholdTest() {
        final int freq = frequencies[currentFreqIndex];
        Log.d("PureToneTest", "Starting ANSI threshold test for frequency: " + freq + " Hz");
        
        // Show ANSI testing UI
        showANSITestingUI();
        
        new Thread(() -> {
            try {
                // Start ANSI threshold procedure for this frequency
                boolean started = audiometryEngine.startThresholdTest(currentEar, freq);
                
                if (!started) {
                    Log.e("PureToneTest", "Failed to start ANSI threshold test");
                    runOnUiThread(() -> {
                        Toast.makeText(PureToneTestActivity.this, "Failed to start test", Toast.LENGTH_SHORT).show();
                        useANSITesting = false;
                        startLegacyRampTest();
                    });
                    return;
                }
                
                // The ANSI engine will manage the test procedure
                // User responses are handled via processResponse() calls from button clicks
                Log.d("PureToneTest", "ANSI threshold test started successfully for " + freq + "Hz");
                
            } catch (Exception e) {
                Log.e("PureToneTest", "Error starting ANSI test: " + e.getMessage());
                runOnUiThread(() -> {
                    Toast.makeText(PureToneTestActivity.this, "Error starting test", Toast.LENGTH_SHORT).show();
                    useANSITesting = false;
                    startLegacyRampTest();
                });
            }
        }).start();
    }
    
    private void startLegacyRampTest() {
        Log.d("PureToneTest", "Using legacy ramp test for frequency index: " + currentFreqIndex);
        
        // Check audio device before starting
        checkAudioDevice();
        
        // Initialize ramping state
        isRamping = true;
        reachedMaxVolume = false;
        
        // Show only thumbs up button initially
        showRampingUI();
        
        stopPlayback = false;
        progressBar.setProgress(0);

        final int freq = frequencies[currentFreqIndex];
        Log.d("PureToneTest", "Starting legacy tone playback for frequency: " + freq + " Hz");
        
        playbackThread = new Thread(() -> {
            // Calculate proper buffer size
            int minBufferSize = AudioTrack.getMinBufferSize(44100, AudioFormat.CHANNEL_OUT_MONO, AudioFormat.ENCODING_PCM_16BIT);
            int bufferSize = Math.max(minBufferSize * 4, 44100); // 4x minimum or 1 second
            
            Log.d("PureToneTest", "Audio buffer setup - minSize: " + minBufferSize + ", using: " + bufferSize);
            
            AudioTrack track = new AudioTrack(
                AudioManager.STREAM_MUSIC,
                44100,
                AudioFormat.CHANNEL_OUT_MONO,
                AudioFormat.ENCODING_PCM_16BIT,
                bufferSize,
                AudioTrack.MODE_STREAM
            );
            
            Log.d("PureToneTest", "AudioTrack created - State: " + track.getState() + ", PlayState: " + track.getPlayState());
            
            if (track.getState() != AudioTrack.STATE_INITIALIZED) {
                Log.e("PureToneTest", "AudioTrack initialization failed - State: " + track.getState());
                runOnUiThread(() -> Toast.makeText(this, "Audio initialization failed", Toast.LENGTH_SHORT).show());
                return;
            }
            
            track.play();
            Log.d("PureToneTest", "AudioTrack.play() called - PlayState now: " + track.getPlayState());
            Log.d("PureToneTest", "Starting tone generation for " + freq + "Hz at 20% initial volume");

            // Start at 20% volume (audible level) and ramp up
            for (int i = 20; i <= 100 && !stopPlayback; i += 2) {
                double amp = i / 100.0;
                short[] chunk = ToneGenerator.generateSineWaveChunk(44100, 100, freq, amp); // 100ms chunks
                
                int bytesWritten = track.write(chunk, 0, chunk.length);
                if (bytesWritten < 0) {
                    Log.e("PureToneTest", "AudioTrack write error: " + bytesWritten);
                    break;
                }
                
                lastAmplitudeStep = i;
                final int progress = (i - 20) * 100 / 80; // Scale to 0-100
                
                runOnUiThread(() -> progressBar.setProgress(progress));
                
                // Check if we've reached maximum volume
                if (i >= 100) {
                    reachedMaxVolume = true;
                    runOnUiThread(() -> {
                        // Switch to thumbs down button at max volume
                        showMaxVolumeUI();
                    });
                    break;
                }
                
                // No Thread.sleep() - let AudioTrack buffer handle timing
                // This prevents audio dropouts and keeps UI responsive
            }

            track.stop();
            track.release();
            
            isRamping = false;
        });
        playbackThread.start();
    }

    private void recordHeardAndAdvance() {
        Log.d("PureToneTest", "recordHeardAndAdvance called - ear: " + currentEar + ", frequency: " + frequencies[currentFreqIndex] + "Hz, amplitude: " + lastAmplitudeStep);
        
        new Thread(() -> {
            try {
                int freq = frequencies[currentFreqIndex];
                
                // Validate parameters before database insertion
                if (userId <= 0 || hearingProfileId <= 0) {
                    Log.e("PureToneTest", "Invalid user/profile IDs - userId: " + userId + ", profileId: " + hearingProfileId);
                    runOnUiThread(() -> {
                        Toast.makeText(this, "Invalid user data - cannot save result", Toast.LENGTH_SHORT).show();
                        // Continue anyway to avoid getting stuck
                        advanceToNextFrequencyOrComplete();
                    });
                    return;
                }
                
                // Ensure HearingProfile exists before inserting HearingTestResult
                AppDatabase db = AppDatabase.getInstance(this);
                com.example.audion.data.HearingProfileDao profileDao = db.hearingProfileDao();
                com.example.audion.data.HearingProfile profile = profileDao.getHearingProfileById(hearingProfileId);
                if (profile == null) {
                    // Create a default profile if it doesn't exist
                    Log.d("PureToneTest", "Creating default HearingProfile with ID: " + hearingProfileId);
                    com.example.audion.data.HearingProfile newProfile = new com.example.audion.data.HearingProfile("Standard Mode", "default_icon");
                    long newId = profileDao.insert(newProfile);
                    hearingProfileId = (int) newId;
                    Log.d("PureToneTest", "Created HearingProfile with new ID: " + hearingProfileId);
                }
                
                HearingTestResult result = new HearingTestResult(
                    userId, currentEar, freq, lastAmplitudeStep, hearingProfileId
                );
                
                Log.d("PureToneTest", "Inserting result into database: userId=" + userId + ", ear=" + currentEar + ", freq=" + freq + ", amp=" + lastAmplitudeStep + ", profileId=" + hearingProfileId);
                
                hearingTestResultDao.insert(result);
                
                Log.d("PureToneTest", "Database insertion successful, advancing to next frequency or completing test");
                runOnUiThread(this::advanceToNextFrequencyOrComplete);
                
            } catch (Exception e) {
                Log.e("PureToneTest", "Error in recordHeardAndAdvance", e);
                runOnUiThread(() -> {
                    Toast.makeText(this, "Failed to save result: " + e.getMessage(), Toast.LENGTH_SHORT).show();
                    // Continue anyway to avoid getting stuck
                    advanceToNextFrequencyOrComplete();
                });
            }
        }).start();
    }

