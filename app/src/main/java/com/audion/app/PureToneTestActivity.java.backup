        // Hide all response buttons and show start again button below
        buttonHeard   .setVisibility(View.GONE);
        buttonNotHeard.setVisibility(View.GONE);
        LinearLayout responseButtonsRow = findViewById(R.id.responseButtonsRow);
        if (responseButtonsRow != null) {
