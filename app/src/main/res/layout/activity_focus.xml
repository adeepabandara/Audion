<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@android:color/white"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- ─── Tabs at the top ──────────────────────────────────────────── -->
    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tabLayout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@android:color/white"
        android:paddingTop="4dp"
        android:paddingBottom="0dp"
        app:tabMode="fixed"
        app:tabGravity="fill"
        app:tabIndicatorColor="@color/primary"
        app:tabSelectedTextColor="@color/primary"
        app:tabTextColor="@color/primary"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- ─── Main content area (scrollable) ──────────────── -->
    <ScrollView
        android:id="@+id/contentScrollView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/tabLayout"
        app:layout_constraintBottom_toTopOf="@id/enrollButton"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/contentContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="8dp"
            android:paddingBottom="16dp">

            <!-- Main content group (image + description) centered - VISIBLE BY DEFAULT -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/mainContentGroup"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:visibility="visible"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <!-- Image centered -->
                <ImageView
                    android:id="@+id/focusModeImage"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_marginStart="@dimen/slide_image_horizontal_margin"
                    android:layout_marginEnd="@dimen/slide_image_horizontal_margin"
                    android:contentDescription="Focus Mode"
                    android:scaleType="fitCenter"
                    android:adjustViewBounds="true"
                    android:src="@drawable/focus"
                    app:layout_constraintDimensionRatio="H,1:1"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toTopOf="@id/focusModeDescription"/>

                <!-- Description text -->
                <TextView
                    android:id="@+id/focusModeDescription"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/onboarding_horizontal_padding"
                    android:layout_marginEnd="@dimen/onboarding_horizontal_padding"
                    android:layout_marginTop="@dimen/slide_description_top_margin"
                    android:gravity="center"
                    android:lineSpacingExtra="4dp"
                    android:text="Scan your environment to detect speakers."
                    android:textColor="@android:color/black"
                    android:textSize="16sp"
                    android:fontFamily="@font/poppins"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/focusModeImage"
                    app:layout_constraintBottom_toBottomOf="parent"/>

            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- Scanning Status Container (shown during scan) -->
            <LinearLayout
                android:id="@+id/scanningContainer"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:visibility="gone"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingStart="32dp"
                android:paddingEnd="32dp"
                android:paddingTop="32dp"
                android:paddingBottom="32dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <!-- Scan Animation (Lottie) -->
                <com.airbnb.lottie.LottieAnimationView
                    android:id="@+id/scanAnimation"
                    android:layout_width="200dp"
                    android:layout_height="200dp"
                    app:lottie_autoPlay="true"
                    app:lottie_fileName="scan.json"
                    app:lottie_loop="true" />

                <!-- Status text -->
                <TextView
                    android:id="@+id/scanStatusText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:text="Calibrating microphone…"
                    android:textSize="16sp"
                    android:lineSpacingExtra="4dp"
                    android:textColor="@color/text_secondary"
                    android:gravity="center" />

                <!-- Progress bar -->
                <ProgressBar
                    android:id="@+id/scanProgress"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="240dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:max="100"
                    android:progress="0"
                    android:indeterminate="false"
                    android:progressTint="@color/primary" />

            </LinearLayout>

            <!-- Diarization Status Container (shown during diarization) -->
            <LinearLayout
                android:id="@+id/diarizationContainer"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:visibility="gone"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingStart="32dp"
                android:paddingEnd="32dp"
                android:paddingTop="32dp"
                android:paddingBottom="32dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <!-- Diarization Animation (Lottie) -->
                <com.airbnb.lottie.LottieAnimationView
                    android:id="@+id/diarizationAnimation"
                    android:layout_width="200dp"
                    android:layout_height="200dp"
                    app:lottie_autoPlay="true"
                    app:lottie_fileName="wave_loading.json"
                    app:lottie_loop="true" />

                <!-- Status text -->
                <TextView
                    android:id="@+id/diarizationStatusText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:text="Starting diarization…"
                    android:textSize="16sp"
                    android:lineSpacingExtra="4dp"
                    android:textColor="@color/text_secondary"
                    android:gravity="center"/>

                <!-- Progress bar -->
                <ProgressBar
                    android:id="@+id/diarizationProgress"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="240dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:max="100"
                    android:progress="0"
                    android:indeterminate="false"
                    android:progressTint="@color/primary"/>

            </LinearLayout>

            <!-- Audio Control Container (toggle button + waveform + cards shown after speakers detected) -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/audioControlContainer"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:visibility="gone"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

            <!-- START BUTTON centered like home page -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/toggleButton"
                style="@style/Widget.MaterialComponents.Button"
                android:layout_width="160dp"
                android:layout_height="160dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/circle_button_background"
                android:elevation="6dp"
                android:stateListAnimator="@null"
                android:fontFamily="monospace"
                android:gravity="center"
                android:paddingTop="16dp"
                android:text="Start"
                android:textColor="@android:color/white"
                android:textSize="20sp"
                app:icon="@drawable/ic_play"
                app:iconGravity="top"
                app:iconPadding="0dp"
                app:iconSize="85dp"
                app:iconTint="@null"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>

            <!-- Waveform View - ALWAYS VISIBLE static section -->
            <com.example.audion.WaveformView
                android:id="@+id/focusWaveform"
                android:layout_width="0dp"
                android:layout_height="60dp"
                android:layout_marginTop="16dp"
                android:visibility="visible"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/toggleButton"/>

            <!-- Selected Speaker Card (shown after speaker selection, below waveform) -->
            <include
                android:id="@+id/rotatingBorder"
                layout="@layout/selected_speaker_card"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:layout_marginTop="16dp"
                android:visibility="gone"
                app:layout_constraintTop_toBottomOf="@id/focusWaveform"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"/>

            <!-- CARD 1: AMPLIFICATION SEEKBAR -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/seekBarContainer"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:visibility="visible"
                app:cardBackgroundColor="@android:color/white"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp"
                app:strokeWidth="0dp"
                app:contentPadding="16dp"
                app:cardMaxElevation="6dp"
                app:layout_constraintTop_toBottomOf="@id/rotatingBorder"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_volume_low"
                        android:tint="@color/primary"
                        android:layout_marginEnd="8dp"
                        android:contentDescription="Volume Low"/>

                    <SeekBar
                        android:id="@+id/seekBar"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:max="100"
                        android:progress="50"
                        android:progressTint="@color/primary"
                        android:thumbTint="@color/primary"
                        android:splitTrack="false"/>

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_volume_high"
                        android:tint="@color/primary"
                        android:layout_marginStart="8dp"
                        android:contentDescription="Volume High"/>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- CARD 2: NOISE REDUCTION TOGGLE -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/noiseReductionCard"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                app:cardBackgroundColor="@android:color/white"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp"
                app:strokeWidth="0dp"
                app:contentPadding="16dp"
                app:cardMaxElevation="6dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/seekBarContainer">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/noiseStatusText"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Noise Reduction"
                        android:fontFamily="@font/poppins"
                        android:textSize="14sp"
                        android:textColor="@color/primary"/>

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/noiseRemovalSwitch"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:thumbTint="@color/white"
                        app:trackTint="@color/switch_track_tint"/>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Scan Again Button - Inside ScrollView, below all cards -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/scanAgainButtonInScroll"
                style="@style/PrimaryButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:layout_marginBottom="32dp"
                android:text="Scan Again"
                android:visibility="gone"
                app:layout_constraintTop_toBottomOf="@id/noiseReductionCard"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"/>

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Default Panel (REMOVED - no longer needed) -->

        </androidx.constraintlayout.widget.ConstraintLayout>

    </ScrollView>

    <!-- ─── Scan Environment button fixed at bottom ──────────────── -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/enrollButton"
        style="@style/PrimaryButton"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/onboarding_horizontal_padding"
        android:layout_marginEnd="@dimen/onboarding_horizontal_padding"
        android:layout_marginBottom="32dp"
        android:text="Scan Environment"
        app:layout_constraintBottom_toTopOf="@id/modeToggleContainer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- ─── Scan Again button fixed at bottom (same position as enrollButton) ──────────────── -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/scanAgainButton"
        style="@style/PrimaryButton"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:layout_marginBottom="32dp"
        android:text="Scan Again"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/modeToggleContainer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- ─── Loading overlay ──────────────────────────────────────────────── -->
    <FrameLayout
        android:id="@+id/loadingOverlay"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@android:color/white"
        android:visibility="visible"
        app:layout_constraintTop_toBottomOf="@id/tabLayout"
        app:layout_constraintBottom_toTopOf="@id/modeToggleContainer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.airbnb.lottie.LottieAnimationView
            android:layout_width="160dp"
            android:layout_height="148dp"
            app:lottie_fileName="wave_loading.json"
            app:lottie_autoPlay="true"
            app:lottie_loop="true"
            android:layout_gravity="center"/>
    </FrameLayout>

    <!-- ─── Bottom mode toggle ─────────────────────────────────────────── -->
    <LinearLayout
        android:id="@+id/modeToggleContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_margin="16dp"
        app:layout_constraintBottom_toTopOf="@id/bottomNavigationView"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- ─── Bottom navigation ───────────────────────────────────────────── -->
    <include
        android:id="@+id/bottomNavigationView"
        layout="@layout/bottom_navigation"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>
