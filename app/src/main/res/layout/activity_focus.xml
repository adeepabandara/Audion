<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F0FDFA">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- ─── TabLayout at the very top ──────────────────────────────────────── -->
        <com.google.android.material.tabs.TabLayout
            android:id="@+id/tabLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:tabIndicatorColor="@color/primary"
            app:tabSelectedTextColor="@color/primary"
            app:tabTextColor="@color/outline" />

        <!-- everything below the tabs, above the bottom buttons, scrolls -->
        <ScrollView
            android:id="@+id/mainScrollView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_below="@id/tabLayout"
            android:layout_above="@+id/modeToggleContainer"
            android:fillViewport="true"
            android:padding="20dp"
            android:clipToPadding="false">

            <LinearLayout
                android:id="@+id/focus_root"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="top|center_horizontal">

                <!-- small top spacer -->
                <Space
                    android:layout_width="match_parent"
                    android:layout_height="16dp"/>

                <!-- Start/Stop toggle + inline panel + scan button -->
                <FrameLayout
                    android:id="@+id/centerContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <LinearLayout
                        android:id="@+id/centerContent"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="top|center_horizontal">

                        <!-- Start/Stop toggle button -->
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/toggleButton"
                            style="@style/Widget.MaterialComponents.Button"
                            android:layout_width="200dp"
                            android:layout_height="200dp"
                            android:gravity="center"
                            android:fontFamily="monospace"
                            android:text="Start"
                            android:textSize="20sp"
                            android:textColor="@android:color/white"
                            android:background="@drawable/circle_button_background"
                            app:icon="@drawable/ic_play"
                            app:iconSize="130dp"
                            app:iconGravity="top"
                            app:iconPadding="-25dp"
                            app:iconTint="@null" />

                        <com.example.audion.WaveformView
                            android:id="@+id/focusWaveform"
                            android:layout_width="match_parent"
                            android:layout_height="50dp"
                            android:layout_marginTop="16dp"
                            android:visibility="gone"/>

                        <!-- Inline content panel -->
                        <FrameLayout
                            android:id="@+id/defaultPanel"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content" />

                        <!-- Scan Environment button -->
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/enrollButton"
                            android:layout_width="315dp"
                            android:layout_height="60dp"
                            android:layout_marginTop="16dp"
                            android:backgroundTint="#0F766E"
                            android:text="Scan Environment"
                            android:textAllCaps="false"
                            android:textColor="#FFFFFF"
                            android:textSize="16sp"
                            app:cornerRadius="20dp" />
                    </LinearLayout>
                </FrameLayout>

                <!-- optional global-speakers list -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/globalSpeakersRecyclerView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="16dp"
                    android:visibility="gone" />

                <!-- Seek-bar container -->
                <LinearLayout
                    android:id="@+id/seekBarContainer"
                    android:visibility="gone"
                    android:layout_width="319dp"
                    android:layout_height="60dp"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/rounded_mint_card"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingLeft="24dp"
                    android:paddingTop="12dp"
                    android:paddingRight="24dp"
                    android:paddingBottom="12dp">

                    <ImageView
                        android:id="@+id/volumeIcon"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_marginRight="12dp"
                        android:src="@drawable/volume" />

                    <!-- your original custom-styled SeekBar -->
                    <SeekBar
                        android:id="@+id/seekBar"
                        android:layout_width="247dp"
                        android:layout_height="20dp"
                        android:max="100"
                        android:minHeight="0dp"
                        android:paddingTop="8dp"
                        android:paddingBottom="8dp"
                        android:progressDrawable="@drawable/seekbar_custom_progress"
                        android:splitTrack="false"
                        android:thumb="@drawable/seekbar_custom_thumb"
                        android:thumbOffset="0dp" />
                </LinearLayout>

                <!-- enrolled speakers list -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/enrolledSpeakersRecyclerView"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="200dp"
                    android:layout_marginTop="8dp"
                    android:padding="8dp" />

                <TextView
                    android:id="@+id/noSpeakersText"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="8dp"
                    android:textColor="#000000" />
            </LinearLayout>
        </ScrollView>

        <!-- ─── Loading overlay between TabLayout and bottom controls ───────────── -->
        <FrameLayout
            android:id="@+id/loadingOverlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_below="@id/tabLayout"
            android:layout_above="@id/modeToggleContainer"
            android:background="#FFFFFF"
            android:visibility="visible"
            android:elevation="10dp">

            <com.airbnb.lottie.LottieAnimationView
                android:id="@+id/diarizationAnimation"
                android:layout_width="160dp"
                android:layout_height="148dp"
                app:lottie_fileName="wave_loading.json"
                app:lottie_autoPlay="true"
                app:lottie_loop="true"
                android:layout_gravity="center"/>
        </FrameLayout>

        <!-- fixed bottom controls -->
        <LinearLayout
            android:id="@+id/modeToggleContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_above="@id/bottomNavigationView"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="16dp"/>

        <include
            android:id="@+id/bottomNavigationView"
            layout="@layout/bottom_navigation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"/>

    </RelativeLayout>
</FrameLayout>
