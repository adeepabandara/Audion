<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/white"
    android:padding="@dimen/onboarding_horizontal_padding"
    android:fitsSystemWindows="true">

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:fontFamily="@font/poppins"
        android:textStyle="bold"
        android:gravity="center_horizontal"
        android:maxLines="2"
        android:ellipsize="end"
        android:autoSizeTextType="uniform"
        android:autoSizeMinTextSize="@dimen/start_test_title_min_text_size"
        android:autoSizeMaxTextSize="@dimen/start_test_title_max_text_size"
        android:autoSizeStepGranularity="1sp"
        android:text="Personalize Your Hearing"
        android:textColor="@android:color/black"
        android:textSize="@dimen/start_test_title_text_size"
        app:layout_constraintBottom_toTopOf="@id/ivIllustration"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"
        app:layout_constraintVertical_bias="0.5" />

    <ImageView
        android:id="@+id/ivIllustration"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/start_test_image_top_margin"
        android:contentDescription="Pure tone test illustration"
        android:scaleType="fitCenter"
        android:adjustViewBounds="true"
        android:src="@drawable/ear"
        app:layout_constraintDimensionRatio="H,1:1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvTitle"
        app:layout_constraintBottom_toTopOf="@id/tvDescription" />

    <TextView
        android:id="@+id/tvDescription"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/start_test_description_top_margin"
        android:fontFamily="@font/poppins"
        android:gravity="center"
        android:lineSpacingExtra="4dp"
        android:maxLines="4"
        android:ellipsize="end"
        android:autoSizeTextType="uniform"
        android:autoSizeMinTextSize="@dimen/slide_description_min_text_size"
        android:autoSizeMaxTextSize="@dimen/slide_description_max_text_size"
        android:autoSizeStepGranularity="1sp"
        android:text="No appointments, no trouble. Audion helps you get your pure-tone audiogram right from your phone."
        android:textColor="@android:color/black"
        android:textSize="@dimen/slide_description_text_size"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/ivIllustration"
        app:layout_constraintBottom_toTopOf="@id/btnStartTest" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnStartTest"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_marginBottom="12dp"
        android:backgroundTint="#0F766E"
        android:text="Get Started"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textAllCaps="false"
        android:fontFamily="@font/poppins"
        app:cornerRadius="8dp"
        app:layout_constraintBottom_toTopOf="@id/btnContinueLater"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnContinueLater"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_marginBottom="32dp"
        android:backgroundTint="@android:color/white"
        android:text="Continue Later"
        android:textColor="#0F766E"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textAllCaps="false"
        android:fontFamily="@font/poppins"
        app:strokeColor="#0F766E"
        app:strokeWidth="2dp"
        app:cornerRadius="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
