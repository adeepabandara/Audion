<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/contentScroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:padding="20dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal">

            <Space
                android:layout_width="match_parent"
                android:layout_height="13dp"/>

            <TextView
                android:id="@+id/title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="48dp"
                android:gravity="center"
                android:text="Left Ear Test"
                android:textColor="#1A6958"
                android:textSize="24sp"
                android:textStyle="bold"/>

            <LinearLayout
                android:id="@+id/stepper_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:weightSum="8"
                android:layout_marginBottom="48dp">

                <FrameLayout
                    android:id="@+id/step1"
                    android:layout_width="0dp"
                    android:layout_height="30dp"
                    android:layout_weight="1">
                    <ImageView
                        android:id="@+id/step1Image"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:src="@drawable/circle_default"/>
                    <TextView
                        android:id="@+id/step1Text"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:text="1"
                        android:textColor="#0F766E"/>
                </FrameLayout>

                <View
                    android:layout_width="4dp"
                    android:layout_height="match_parent"
                    />

                <FrameLayout
                    android:id="@+id/step2"
                    android:layout_width="0dp"
                    android:layout_height="30dp"
                    android:layout_weight="1">
                    <ImageView
                        android:id="@+id/step2Image"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:src="@drawable/circle_default"/>
                    <TextView
                        android:id="@+id/step2Text"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:text="2"
                        android:textColor="#0F766E"/>
                </FrameLayout>

                <View
                    android:layout_width="4dp"
                    android:layout_height="match_parent"
                    />

                <FrameLayout
                    android:id="@+id/step3"
                    android:layout_width="0dp"
                    android:layout_height="30dp"
                    android:layout_weight="1">
                    <ImageView
                        android:id="@+id/step3Image"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:src="@drawable/circle_default"/>
                    <TextView
                        android:id="@+id/step3Text"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:text="3"
                        android:textColor="#0F766E"/>
                </FrameLayout>

                <View
                    android:layout_width="4dp"
                    android:layout_height="match_parent"
                    />

                <FrameLayout
                    android:id="@+id/step4"
                    android:layout_width="0dp"
                    android:layout_height="30dp"
                    android:layout_weight="1">
                    <ImageView
                        android:id="@+id/step4Image"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:src="@drawable/circle_default"/>
                    <TextView
                        android:id="@+id/step4Text"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:text="4"
                        android:textColor="#0F766E"/>
                </FrameLayout>

                <View
                    android:layout_width="4dp"
                    android:layout_height="match_parent"
                   />

                <FrameLayout
                    android:id="@+id/step5"
                    android:layout_width="0dp"
                    android:layout_height="30dp"
                    android:layout_weight="1">
                    <ImageView
                        android:id="@+id/step5Image"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:src="@drawable/circle_default"/>
                    <TextView
                        android:id="@+id/step5Text"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:text="5"
                        android:textColor="#0F766E"/>
                </FrameLayout>

                <View
                    android:layout_width="4dp"
                    android:layout_height="match_parent"
                   />

                <FrameLayout
                    android:id="@+id/step6"
                    android:layout_width="0dp"
                    android:layout_height="30dp"
                    android:layout_weight="1">
                    <ImageView
                        android:id="@+id/step6Image"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:src="@drawable/circle_default"/>
                    <TextView
                        android:id="@+id/step6Text"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:text="6"
                        android:textColor="#0F766E"/>
                </FrameLayout>

                <View
                    android:layout_width="4dp"
                    android:layout_height="match_parent"
                    />

                <FrameLayout
                    android:id="@+id/step7"
                    android:layout_width="0dp"
                    android:layout_height="30dp"
                    android:layout_weight="1">
                    <ImageView
                        android:id="@+id/step7Image"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:src="@drawable/circle_default"/>
                    <TextView
                        android:id="@+id/step7Text"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:text="7"
                        android:textColor="#0F766E"/>
                </FrameLayout>

                <View
                    android:layout_width="4dp"
                    android:layout_height="match_parent"
                    />

                <FrameLayout
                    android:id="@+id/step8"
                    android:layout_width="0dp"
                    android:layout_height="30dp"
                    android:layout_weight="1">
                    <ImageView
                        android:id="@+id/step8Image"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:src="@drawable/circle_default"/>
                    <TextView
                        android:id="@+id/step8Text"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:text="8"
                        android:textColor="#0F766E"/>
                </FrameLayout>

            </LinearLayout>

            <ImageView
                android:id="@+id/imageViewEar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                android:adjustViewBounds="true"
                android:maxWidth="312dp"
                android:maxHeight="226dp"
                android:scaleType="fitCenter"/>

            <ProgressBar
                android:id="@+id/progressBar"
                style="@android:style/Widget.ProgressBar.Horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                android:max="100"
                android:progress="0"
                android:progressBackgroundTint="#EFEFEF"
                android:progressTint="#0F766E"/>

            <View
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"/>

            <LinearLayout
                android:id="@+id/responseButtonsRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:weightSum="2"
                android:layout_marginBottom="16dp"
                android:background="@android:color/transparent"
                android:visibility="gone">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/buttonNotHeard"
                    android:layout_width="0dp"
                    android:layout_height="80dp"
                    android:layout_weight="1"
                    android:minWidth="0dp"
                    android:backgroundTint="@color/background"
                    app:strokeColor="@color/red_cant"
                    app:strokeWidth="3dp"
                    app:cornerRadius="40dp"
                    android:text="👎"
                    android:textColor="@color/red_cant"
                    android:textSize="32sp"
                    android:textAllCaps="false"
                    android:fontFamily="@font/dm_sans"
                    android:visibility="gone"/>

                <Space
                    android:layout_width="16dp"
                    android:layout_height="0dp"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/buttonHeard"
                    android:layout_width="0dp"
                    android:layout_height="80dp"
                    android:layout_weight="1"
                    android:minWidth="0dp"
                    android:backgroundTint="@color/background"
                    app:strokeColor="@color/green_hear"
                    app:strokeWidth="3dp"
                    app:cornerRadius="40dp"
                    android:text="👍"
                    android:textColor="@color/green_hear"
                    android:textSize="32sp"
                    android:textAllCaps="false"
                    android:fontFamily="@font/dm_sans"
                    android:visibility="gone"/>
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonStart"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="16dp"
                android:backgroundTint="@color/background"
                android:text="START TEST"
                android:textColor="@color/primary"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textAllCaps="false"
                app:strokeColor="@color/primary"
                app:strokeWidth="2dp"
                app:cornerRadius="20dp"
                android:visibility="visible"/>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
