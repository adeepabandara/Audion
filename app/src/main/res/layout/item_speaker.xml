<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="6dp"
    android:layout_marginBottom="6dp"
    app:cardBackgroundColor="@color/white"
    app:cardCornerRadius="12dp"
    app:cardElevation="4dp"
    app:contentPadding="16dp"
    app:cardMaxElevation="6dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="28dp"
        android:layout_gravity="center"
        android:maxWidth="500dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- Radio Button on the left -->
        <RadioButton
            android:id="@+id/speakerRadioButton"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginEnd="12dp"
            android:buttonTint="@color/primary"
            android:layout_gravity="center_vertical"/>

        <!-- Speaker name in the middle -->
        <TextView
            android:id="@+id/speakerIdText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Speaker 1"
            android:textSize="16sp"
            android:textColor="@android:color/black"
            android:fontFamily="@font/poppins"
            android:textStyle="normal" />

        <!-- Play/Stop button on the right (circular) -->
        <ImageButton
            android:id="@+id/speakerPlayButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_play"
            android:background="@drawable/circle_button_background"
            android:scaleType="centerInside"
            android:padding="8dp"
            android:tint="@color/white"
            android:contentDescription="Play speaker audio" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView> 