<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="8dp"
    android:layout_marginEnd="8dp"
    android:layout_marginTop="6dp"
    android:layout_marginBottom="6dp"
    app:cardBackgroundColor="@color/white"
    app:cardCornerRadius="12dp"
    app:cardElevation="4dp"
    app:contentPadding="12dp"
    app:cardMaxElevation="6dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:minHeight="56dp">

        <!-- Radio Button on the left -->
        <RadioButton
            android:id="@+id/speakerRadioButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="12dp"
            android:buttonTint="@color/primary"
            android:focusable="false"
            android:focusableInTouchMode="false"
            android:layout_gravity="center_vertical"/>

        <!-- Speaker info container -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- Speaker name -->
            <TextView
                android:id="@+id/speakerNameText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Speaker 1"
                android:textSize="16sp"
                android:textColor="@android:color/black"
                android:fontFamily="@font/poppins"
                android:textStyle="normal" />

            <!-- Duration -->
            <TextView
                android:id="@+id/speakerDurationText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Duration: 0.0s"
                android:textSize="12sp"
                android:textColor="#666666"
                android:fontFamily="@font/poppins"
                android:layout_marginTop="2dp"/>

        </LinearLayout>

        <!-- Play button container with progress bar -->
        <FrameLayout
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="12dp">

            <!-- Play button -->
            <ImageButton
                android:id="@+id/playButton"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_play"
                android:background="@drawable/circle_button_background"
                android:scaleType="centerInside"
                android:padding="8dp"
                android:tint="@color/white"
                android:contentDescription="Play speaker audio" />

            <!-- Circular progress bar with light grey background and white progress -->
            <ProgressBar
                android:id="@+id/playbackProgress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="center"
                android:progressDrawable="@drawable/circular_progress"
                android:indeterminate="false"
                android:max="100"
                android:progress="0"
                android:visibility="gone"
                android:contentDescription="Playback progress indicator"/>

        </FrameLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
