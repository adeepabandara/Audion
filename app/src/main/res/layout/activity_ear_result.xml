<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_pastel_gradient"
    android:padding="32dp">

    <!-- Success Icon -->
    <TextView
        android:id="@+id/tickAnimation"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:layout_marginTop="80dp"
        android:text="✓"
        android:textSize="72sp"
        android:textColor="#4CAF50"
        android:gravity="center"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Ear Label -->
    <TextView
        android:id="@+id/tvEarLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Right Ear"
        android:textColor="@android:color/black"
        android:textSize="32sp"
        android:textStyle="bold"
        android:fontFamily="sans-serif"
        android:layout_marginTop="32dp"
        app:layout_constraintTop_toBottomOf="@id/tickAnimation"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Completion Message -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Calibration Complete!"
        android:textColor="@android:color/black"
        android:textSize="24sp"
        android:textStyle="bold"
        android:fontFamily="sans-serif"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/tvEarLabel"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Result Chip -->
    <com.google.android.material.chip.Chip
        android:id="@+id/resultChip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:text="Volume: 50%"
        android:textSize="18sp"
        android:textStyle="bold"
        app:chipBackgroundColor="@color/primary"
        android:textColor="@android:color/white"
        app:layout_constraintTop_toBottomOf="@id/tvEarLabel"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Continue Text -->
    <TextView
        android:id="@+id/tvContinueText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Tap Next to Continue to Left ear"
        android:textColor="@android:color/black"
        android:textSize="16sp"
        android:fontFamily="sans-serif"
        android:gravity="center"
        android:layout_marginTop="48dp"
        android:layout_marginBottom="32dp"
        app:layout_constraintTop_toBottomOf="@id/resultChip"
        app:layout_constraintBottom_toTopOf="@id/buttonNext"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Next Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/buttonNext"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:text="Next"
        android:textColor="@android:color/white"
        android:textSize="18sp"
        android:textStyle="bold"
        android:fontFamily="sans-serif"
        android:backgroundTint="#0F766E"
        app:cornerRadius="28dp"
        android:layout_marginBottom="60dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintWidth_percent="0.7" />

</androidx.constraintlayout.widget.ConstraintLayout>
