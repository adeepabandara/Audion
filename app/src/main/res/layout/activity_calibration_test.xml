<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp">

    <!-- Show calibration test GIF -->
    <pl.droidsonroids.gif.GifImageView
        android:id="@+id/imageEar"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:layout_gravity="center_horizontal"
        android:src="@drawable/calibration_test" />

    <!-- Which step we're on -->
    <TextView
        android:id="@+id/textStepLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Adjust the slider to a comfortable volume"
        android:textAppearance="?attr/textAppearanceHeadline6" />

    <!-- Card around the SeekBar -->
    <com.google.android.material.card.MaterialCardView
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        app:cardElevation="4dp"
        app:cardCornerRadius="16dp"
        app:cardBackgroundColor="@android:color/white">

        <!-- SeekBar for volume control -->
        <SeekBar
            android:id="@+id/volumeSeekBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp"
            android:max="100"
            android:progress="50" />

    </com.google.android.material.card.MaterialCardView>

    <!-- Progress of the tone playing (hidden for new design) -->
    <ProgressBar
        style="?android:attr/progressBarStyleHorizontal"
        android:id="@+id/progressBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:max="100"
        android:progress="0"
        android:visibility="gone" />

    <!-- Buttons appear once the tone “playback” is done -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/buttonHeard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="Continue"
        android:visibility="visible" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/buttonNotHeard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Not heard"
        android:visibility="gone" />

</LinearLayout>
