<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="#F0FDFA">


    <Space
        android:layout_width="match_parent"
        android:layout_height="13dp" />

    <TextView
        android:id="@+id/textView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textAlignment="center"
        android:textSize="20dp"/>

    <Space
        android:layout_width="match_parent"
        android:layout_height="17dp" />


  <com.google.android.material.button.MaterialButton
        android:id="@+id/toggleButton"
        style="@style/Widget.MaterialComponents.Button"
        android:layout_width="200dp"
        android:layout_height="200dp"
        android:layout_gravity="center"
        android:gravity="center"
        android:fontFamily="monospace"
        android:text="Start"
        android:textSize="20sp"
        android:textColor="@android:color/white"
        android:background="@drawable/circle_button_background"
        app:icon="@drawable/ic_play"
        app:iconSize="130dp"
        app:iconGravity="top"
        app:iconPadding="-25dp"


        />


    <Space
        android:layout_width="match_parent"
        android:layout_height="28dp" />

    <LinearLayout
    android:layout_width="319dp"
    android:layout_height="60dp"
    android:layout_gravity="center"
    android:layout_marginBottom="16dp"
    android:background="@drawable/rounded_mint_card"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingLeft="4dp"
    android:paddingRight="4dp">

    <!-- Centered text before the waveform -->

    <!-- Waveform view fills remaining space -->
    <com.example.audion.WaveformView
        android:id="@+id/waveformOutput"
        android:layout_width="291dp"
        android:layout_height="16dp"
        android:layout_weight="1"
        android:background="@color/card_bg"
        />
</LinearLayout>



    <LinearLayout
        android:layout_width="319dp"
        android:layout_height="60dp"
        android:layout_gravity="center"
        android:layout_marginBottom="16dp"
        android:background="@drawable/rounded_mint_card"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="24dp"
        android:paddingTop="12dp"
        android:paddingRight="24dp"
        android:paddingBottom="12dp">

        <ImageView
            android:id="@+id/volumeIcon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginRight="12dp"
            android:src="@drawable/volume" />

        <SeekBar
            android:id="@+id/seekBar"
            android:layout_width="247dp"
            android:layout_height="20dp"
            android:max="100"
            android:minHeight="0dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:progressDrawable="@drawable/seekbar_custom_progress"
            android:splitTrack="false"
            android:thumb="@drawable/seekbar_custom_thumb"
            android:thumbOffset="0dp" />

    </LinearLayout>


    <LinearLayout
    android:layout_width="319dp"
    android:layout_height="60dp"
    android:layout_gravity="center"
    android:layout_marginBottom="16dp"
    android:background="@drawable/rounded_mint_card"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingLeft="24dp"
    android:paddingRight="24dp">

    <!-- Noise Cancellation Text + Status Indicator -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- Noise Cancellation Text -->
        <TextView
            android:id="@+id/tvNoiseCancellation"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Noise Cancellation"
            android:textSize="16sp"
            android:fontFamily="sans-serif"
            android:textColor="#000000"
            android:gravity="center_vertical" />

    </LinearLayout>

    <!-- Push the switch to the right -->
    <View
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1" />

    <!-- Switch for Noise Cancellation -->
    <com.google.android.material.switchmaterial.SwitchMaterial
        android:id="@+id/noiseRemovalSwitch"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:checked="false" />
</LinearLayout>


