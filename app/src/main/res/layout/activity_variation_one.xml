<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Main ScrollView container -->
    <ScrollView
        android:id="@+id/mainScrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/bottomNavigationView"
        android:background="#F0FDFA"
        android:fillViewport="true"
        android:padding="20dp">

        <!-- Outer container to center the fixed-width content horizontally -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal">

            <!-- Inner fixed-width container preserving original component dimensions -->
            <LinearLayout
                android:layout_width="319dp"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Top spacing -->
                <Space
                    android:layout_width="match_parent"
                    android:layout_height="13dp" />

                <!-- Optional Title (commented out) -->
                <!--
                <TextView
                    android:id="@+id/textView"
                    android:layout_width="319dp"
                    android:layout_height="wrap_content"
                    android:text="Audio Variation"
                    android:textAlignment="center"
                    android:textSize="20dp" />
                -->

                <Space
                    android:layout_width="match_parent"
                    android:layout_height="17dp" />

                <!-- Toggle Button (circle style) -->
                <LinearLayout
                    android:layout_width="319dp"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:gravity="center">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/toggleButton"
                        style="@style/Widget.MaterialComponents.Button"
                        android:layout_width="200dp"
                        android:layout_height="200dp"
                        android:gravity="center"
                        android:fontFamily="monospace"
                        android:text="Start"
                        android:textSize="20sp"
                        android:textColor="@android:color/white"
                        android:background="@drawable/circle_button_background"
                        app:icon="@drawable/ic_play"
                        app:iconSize="130dp"
                        app:iconGravity="top"
                        app:iconPadding="-25dp" />
                </LinearLayout>

                <Space
                    android:layout_width="match_parent"
                    android:layout_height="28dp" />

                <!-- Global Amplification SeekBar Container (if you still need it) -->
                <LinearLayout
                    android:layout_width="319dp"
                    android:layout_height="60dp"
                    android:layout_marginBottom="16dp"
                    android:background="@drawable/rounded_mint_card"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingLeft="24dp"
                    android:paddingTop="12dp"
                    android:paddingRight="24dp"
                    android:paddingBottom="12dp">

                    <ImageView
                        android:id="@+id/volumeIcon"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_marginRight="12dp"
                        android:src="@drawable/volume" />

                    <SeekBar
                        android:id="@+id/seekBar"
                        android:layout_width="247dp"
                        android:layout_height="20dp"
                        android:max="100"
                        android:minHeight="0dp"
                        android:paddingTop="8dp"
                        android:paddingBottom="8dp"
                        android:progressDrawable="@drawable/seekbar_custom_progress"
                        android:splitTrack="false"
                        android:thumb="@drawable/seekbar_custom_thumb"
                        android:thumbOffset="0dp" />
                </LinearLayout>

                <!-- Noise Cancellation Switch Container -->
                <LinearLayout
                    android:layout_width="319dp"
                    android:layout_height="60dp"
                    android:layout_marginBottom="16dp"
                    android:background="@drawable/rounded_mint_card"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingLeft="24dp"
                    android:paddingRight="24dp">

                    <TextView
                        android:id="@+id/tvNoiseCancellation"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Noise Cancellation"
                        android:textSize="16sp"
                        android:fontFamily="sans-serif"
                        android:textColor="#000000"
                        android:gravity="center_vertical" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1" />

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/noiseRemovalSwitch"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="false" />
                </LinearLayout>

                <!-- REPLACED: Remove Multi-Band Graph View Container -->
                <!-- Instead, add a dropdown for selecting the hearing profile -->
<LinearLayout
    android:layout_width="319dp"
    android:layout_height="wrap_content"
    android:layout_marginTop="16dp"
    android:background="@drawable/rounded_mint_card"
    android:orientation="vertical"
    android:padding="8dp">
    <TextView
         android:id="@+id/tvSelectedProfile"
         android:layout_width="match_parent"
         android:layout_height="wrap_content"
         android:text="Select Hearing Profile"
         android:textSize="16sp"
         android:drawableEnd="@drawable/ic_arrow_drop_down"
         android:padding="8dp"/>
</LinearLayout>


                <Space
                    android:layout_width="match_parent"
                    android:layout_height="22dp" />

                <!-- Waveform Output View Container -->
                <LinearLayout
                    android:layout_width="319dp"
                    android:layout_height="60dp"
                    android:layout_marginBottom="16dp"
                    android:background="@drawable/rounded_mint_card"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingLeft="4dp">

                    <com.example.audion.WaveformView
                        android:id="@+id/waveformOutput"
                        android:layout_width="307dp"
                        android:layout_height="30dp"
                        android:background="#E7FAF5" />
                </LinearLayout>

                <!-- Waveform Input View Container -->
                <LinearLayout
                    android:layout_width="319dp"
                    android:layout_height="60dp"
                    android:layout_marginBottom="16dp"
                    android:background="@drawable/rounded_mint_card"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingLeft="4dp">

                    <com.example.audion.WaveformView
                        android:id="@+id/waveformInput"
                        android:layout_width="307dp"
                        android:layout_height="30dp"
                        android:background="#E7FAF5" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <include
        android:id="@+id/bottomNavigationView"
        layout="@layout/bottom_navigation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true" />
</RelativeLayout>
