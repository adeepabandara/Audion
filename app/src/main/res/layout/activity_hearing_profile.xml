<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    tools:context=".HearingProfileActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Toolbar -->
        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/primary"
            android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar"
            app:popupTheme="@style/ThemeOverlay.AppCompat.Light" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Header Section -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Your Hearing Profile"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/lastTestDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Last updated: Loading..."
                android:textSize="14sp"
                android:textColor="@color/text_secondary"
                android:layout_marginBottom="24dp" />

            <!-- No Data Message -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/noDataMessage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="24dp"
                    android:gravity="center">

                    <ImageView
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:src="@drawable/ic_hearing"
                        android:tint="@color/text_secondary"
                        android:layout_marginBottom="16dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="No Hearing Data Available"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary"
                        android:layout_marginBottom="8dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Complete your hearing test to see your personalized audio profile"
                        android:textSize="14sp"
                        android:textColor="@color/text_secondary"
                        android:gravity="center"
                        android:layout_marginBottom="16dp" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Audiogram Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/audiogramCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Hearing Thresholds (Audiogram)"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary"
                        android:layout_marginBottom="12dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Your personal hearing sensitivity across frequencies"
                        android:textSize="14sp"
                        android:textColor="@color/text_secondary"
                        android:layout_marginBottom="16dp" />

                    <!-- Audiogram Chart -->
                    <com.github.mikephil.charting.charts.LineChart
                        android:id="@+id/audiogramChart"
                        android:layout_width="match_parent"
                        android:layout_height="250dp"
                        android:layout_marginBottom="16dp" />

                    <!-- Ear Summaries -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/leftEarSummary"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Left Ear: Loading..."
                            android:textSize="14sp"
                            android:textColor="@color/text_primary"
                            android:drawableStart="@drawable/ic_circle"
                            android:drawableTint="@color/blue"
                            android:drawablePadding="8dp"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="4dp" />

                        <TextView
                            android:id="@+id/rightEarSummary"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Right Ear: Loading..."
                            android:textSize="14sp"
                            android:textColor="@color/text_primary"
                            android:drawableStart="@drawable/ic_circle"
                            android:drawableTint="@color/red_alert"
                            android:drawablePadding="8dp"
                            android:gravity="center_vertical" />

                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Calibration Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/calibrationCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Comfort &amp; Safety Levels"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary"
                        android:layout_marginBottom="12dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Your personal comfort levels for safe audio amplification"
                        android:textSize="14sp"
                        android:textColor="@color/text_secondary"
                        android:layout_marginBottom="16dp" />

                    <TextView
                        android:id="@+id/calibrationSummary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Loading calibration data..."
                        android:textSize="14sp"
                        android:textColor="@color/text_primary"
                        android:background="@color/card_background"
                        android:padding="12dp"
                        android:fontFamily="monospace" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Action Buttons -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="8dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/retestHearingButton"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:text="RETEST HEARING"
                    android:textSize="16sp"
                    android:layout_marginBottom="12dp"
                    app:cornerRadius="12dp"
                    app:icon="@drawable/ic_hearing"
                    app:iconGravity="start" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/recalibrateButton"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:text="RECALIBRATE COMFORT LEVELS"
                    android:textSize="16sp"
                    app:cornerRadius="12dp"
                    app:icon="@drawable/ic_settings"
                    app:iconGravity="start" />

            </LinearLayout>

            <!-- Medical Disclaimer -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/medical_disclaimer_results"
                android:textSize="11sp"
                android:textColor="@color/onboarding_text_secondary"
                android:gravity="center"
                android:lineSpacingExtra="2dp" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>