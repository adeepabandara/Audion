<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="6dp"
    android:layout_marginBottom="6dp"
    app:cardBackgroundColor="@color/white"
    app:cardCornerRadius="12dp"
    app:cardElevation="4dp"
    app:contentPadding="16dp"
    app:cardMaxElevation="6dp">

    <LinearLayout
        android:id="@+id/globalSpeakerContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:minHeight="48dp">

        <!-- Color indicator circle on the left -->
        <View
            android:id="@+id/globalSpeakerColorIndicator"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="center_vertical"
            android:layout_marginEnd="12dp"
            android:background="@drawable/circle_color_indicator" />

        <!-- Speaker name in the middle -->
        <TextView
            android:id="@+id/globalSpeakerIdText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textStyle="normal"
            android:textSize="16sp"
            android:textColor="@android:color/black"
            android:fontFamily="@font/poppins"
            android:text="Speaker 1" />

        <!-- Play button on the right -->
        <ImageButton
            android:id="@+id/globalSpeakerPlayButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="center_vertical"
            android:src="@drawable/ic_play"
            android:background="@drawable/circle_button_background"
            android:scaleType="centerInside"
            android:padding="8dp"
            android:tint="@color/white"
            android:contentDescription="Play speaker audio" />

        <!-- Hidden stats text -->
        <TextView
            android:id="@+id/globalSpeakerStatsText"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone"
            android:text="10.5s total • 3 chunks" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView> 