<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="#F0FDFA">

    <com.google.android.material.button.MaterialButton
        android:id="@+id/toggleButton"
        style="@style/Widget.MaterialComponents.Button"
        android:layout_width="200dp"
        android:layout_height="200dp"
        android:layout_gravity="center"
        android:gravity="center"
        android:fontFamily="monospace"
        android:text="Start"
        android:textSize="20sp"
        android:textColor="@android:color/white"
        android:background="@drawable/circle_button_background"
        app:icon="@drawable/ic_play"
        app:iconSize="130dp"
        app:iconGravity="top"
        app:iconPadding="-25dp"


        />



    <LinearLayout
        android:layout_width="match_parent"

        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        app:cardBackgroundColor="#FFFFFF"
        app:cardCornerRadius="8dp"
        app:cardElevation="4dp">

        android:layout_height="333dp"
        android:orientation="vertical"
        android:scrollbarThumbHorizontal="@android:drawable/radiobutton_off_background"
        android:scrollbarThumbVertical="@android:drawable/radiobutton_off_background">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/toggleButton"
            style="@style/Widget.MaterialComponents.Button"
            android:layout_width="322dp"
            android:layout_height="66dp"
            android:layout_gravity="center"
            android:layout_marginBottom="16dp"
            android:fontFamily="monospace"
            android:text="Turn On"
            android:textSize="12sp"
            app:backgroundTint="@color/primary"
            app:cornerRadius="20dp" />





        <LinearLayout
            android:layout_width="319dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginBottom="16dp"
            android:background="@drawable/rounded_mint_card"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingLeft="24dp"
            android:paddingTop="12dp"
            android:paddingRight="24dp"
            android:paddingBottom="12dp">


            <SeekBar
                android:id="@+id/seekBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="80dp"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:text="IN"
                    android:textColor="#BBBBBB" />

                <ProgressBar
                    android:id="@+id/inputLevelMeter"
                    style="@style/Widget.AppCompat.ProgressBar.Horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:progressTint="#FF5722" />
            </LinearLayout>

            <TextView
                android:layout_width="215dp"
                android:layout_height="wrap_content"
                android:layout_marginRight="8dp"
                android:fontFamily="sans-serif"
                android:text="Noise cancellation"
                android:textColor="#000000"
                android:textSize="14sp" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/noiseRemovalSwitch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="false"
                android:textColorLink="#009688"
                app:thumbTint="@color/white"
                app:trackTint="@color/grey" />
        </LinearLayout>



                <TextView
                    android:layout_width="80dp"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:text="OUT"
                    android:textColor="#BBBBBB" />

                <ProgressBar
                    android:id="@+id/outputLevelMeter"
                    style="@style/Widget.AppCompat.ProgressBar.Horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:progressTint="#4CAF50" />
            </LinearLayout>

        <LinearLayout
            android:layout_width="319dp"
            android:layout_height="60dp"
            android:layout_gravity="center"
            android:layout_marginBottom="16dp"
            android:background="@drawable/rounded_mint_card"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingLeft="24dp"
            android:paddingTop="12dp"
            android:paddingRight="24dp"
            android:paddingBottom="12dp">

            <ImageView
                android:id="@+id/volumeIcon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginRight="12dp"
                android:src="@drawable/volume" />

            <SeekBar
                android:id="@+id/seekBar"
                android:layout_width="247dp"
                android:layout_height="20dp"
                android:max="100"
                android:minHeight="0dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:progressDrawable="@drawable/seekbar_custom_progress"
                android:splitTrack="false"
                android:thumb="@drawable/seekbar_custom_thumb"
                android:thumbOffset="0dp" />

        </LinearLayout>


    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        app:cardBackgroundColor="#FFFFFF"
        app:cardCornerRadius="8dp"
        app:cardElevation="4dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Noise Removal Switch -->

            <!-- METRICS -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:fontFamily="monospace"
                android:text="AUDIO LEVELS"
                android:textColor="#4CAF50"
                android:textSize="12sp" />

            <TextView
                android:layout_width="80dp"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:text="IN"
                android:textColor="#BBBBBB" />

            <ProgressBar
                android:id="@+id/inputLevelMeter"
                style="@style/Widget.AppCompat.ProgressBar.Horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:progressTint="#FF5722" />

            <TextView
                android:layout_width="80dp"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:text="OUT"
                android:textColor="#BBBBBB" />

            <ProgressBar
                android:id="@+id/outputLevelMeter"
                style="@style/Widget.AppCompat.ProgressBar.Horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:progressTint="#4CAF50" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:fontFamily="monospace"
                android:text="METRICS"
                android:textColor="#4CAF50"
                android:textSize="12sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="120dp"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:text="VAD PROB"
                    android:textColor="#BBBBBB" />

                <TextView
                    android:id="@+id/vadProbability"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:text="0%"
                    android:textColor="#FF5722"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="120dp"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:text="NOISE RED"
                    android:textColor="#BBBBBB" />

                <TextView
                    android:id="@+id/noiseReduction"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:text="0 dB"
                    android:textColor="#4CAF50"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <Button
    android:id="@+id/gotoAudioStreamButton"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:text="Go to Audio Stream"
    android:layout_marginTop="20dp"
    android:layout_centerInParent="true" />

</LinearLayout>


