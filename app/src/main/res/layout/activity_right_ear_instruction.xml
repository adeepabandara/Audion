<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F0FDFA"
    android:fillViewport="true"
    android:padding="20dp">

    <!-- Outer container centers the fixed-width inner container horizontally -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <!-- Inner fixed-width container preserving original component styling -->
        <LinearLayout
            android:id="@+id/layout_pure_tone_test"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Title (centered) -->
            <TextView
                android:id="@+id/title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:gravity="left"
                android:text="Right Ear Test"
                android:textColor="#1A6958"
                android:textSize="32sp"
                android:textStyle="bold" />

            <!-- Intro Text -->
            <TextView
                android:id="@+id/body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:fontFamily="@font/poppins"
                android:lineSpacingExtra="4dp"
                android:text="Fantastic! Let's focus on your right ear now."
                android:textColor="#4A4A4A"
                android:textSize="14sp" />

            <!-- Follow-up Instruction -->
            <TextView
                android:id="@+id/bodyFollowUp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                android:fontFamily="@font/poppins"
                android:text="Press the Start button, and listen carefully. If you hear a sound, simply press the button."
                android:textColor="#4A4A4A"
                android:textSize="14sp" />

            <!-- Ear Image -->
            <ImageView
                android:id="@+id/imageViewEar"
                android:layout_width="312dp"
                android:layout_height="325dp"
                android:layout_gravity="center"
                android:scaleType="fitCenter"
                android:src="@drawable/right_ear" />

            <!-- Spacer to push button to the bottom -->
            <View
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <!-- Start Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonStartRightEarTest"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="16dp"
                android:backgroundTint="#0F766E"
                android:fontFamily="@font/poppins_light"
                android:text="Start"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"
                app:cornerRadius="20dp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
