<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/white">

    <TextView
        android:id="@+id/slideTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/onboarding_horizontal_padding"
        android:layout_marginEnd="@dimen/onboarding_horizontal_padding"
        android:layout_marginTop="@dimen/slide_title_top_margin"
        android:fontFamily="@font/poppins"
        android:textStyle="bold"
        android:gravity="center"
        android:maxLines="3"
        android:ellipsize="end"
        android:autoSizeTextType="uniform"
        android:autoSizeMinTextSize="@dimen/slide_title_min_text_size"
        android:autoSizeMaxTextSize="@dimen/slide_title_max_text_size"
        android:autoSizeStepGranularity="1sp"
        android:textColor="@android:color/black"
        android:textSize="@dimen/slide_title_text_size"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="Welcome to Audion" />

    <ImageView
        android:id="@+id/slideImage"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="@dimen/slide_image_horizontal_margin"
        android:layout_marginEnd="@dimen/slide_image_horizontal_margin"
        android:layout_marginTop="@dimen/slide_image_top_margin"
        android:contentDescription="@string/onboarding_illustration_desc"
        android:scaleType="fitCenter"
        android:adjustViewBounds="true"
        android:src="@drawable/ic_launcher_foreground"
        app:layout_constraintDimensionRatio="H,1:1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/slideTitle"
        app:layout_constraintBottom_toTopOf="@id/slideDescription"
        app:layout_constraintVertical_chainStyle="packed"
        app:layout_constraintVertical_bias="0.3" />

    <TextView
        android:id="@+id/slideDescription"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/onboarding_horizontal_padding"
        android:layout_marginEnd="@dimen/onboarding_horizontal_padding"
        android:layout_marginTop="@dimen/slide_description_top_margin"
        android:layout_marginBottom="@dimen/margin_large"
        android:fontFamily="@font/poppins"
        android:gravity="center"
        android:lineSpacingExtra="4dp"
        android:maxLines="4"
        android:ellipsize="end"
        android:autoSizeTextType="uniform"
        android:autoSizeMinTextSize="@dimen/slide_description_min_text_size"
        android:autoSizeMaxTextSize="@dimen/slide_description_max_text_size"
        android:autoSizeStepGranularity="1sp"
        android:textColor="@android:color/black"
        android:textSize="@dimen/slide_description_text_size"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/slideImage"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintVertical_bias="0.0"
        tools:text="Your personal hearing companion" />

</androidx.constraintlayout.widget.ConstraintLayout>
