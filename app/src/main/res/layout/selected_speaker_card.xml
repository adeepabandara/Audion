<?xml version="1.0" encoding="utf-8"?>
<!-- Selected speaker card with animated border -->
<com.example.audion.RotatingBorderView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rotatingBorder"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="4dp"
    android:clickable="true"
    android:focusable="true"
    android:visibility="gone">

    <!-- Speaker card inside the animated border view - no elevation to avoid double border -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/selectedSpeakerCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="@color/white"
        app:cardCornerRadius="12dp"
        app:cardElevation="0dp"
        app:contentPadding="16dp"
        app:cardMaxElevation="0dp"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?android:attr/selectableItemBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:minHeight="28dp">

        <!-- Left side: Speaker icon -->
        <ImageView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginEnd="12dp"
            android:src="@drawable/focus_icon"
            android:scaleType="fitCenter"
            android:contentDescription="Speaker icon"/>

        <!-- Speaker info -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/cardSpeakerName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Please select a speaker"
                android:textSize="14sp"
                android:textColor="@color/primary"
                android:fontFamily="@font/poppins"
                android:textStyle="normal"/>

        </LinearLayout>

    </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

</com.example.audion.RotatingBorderView>
