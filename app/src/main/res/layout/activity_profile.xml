<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="@color/white">

    <LinearLayout
        android:id="@+id/profileContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/bottomNavigationView"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="24dp"
        android:paddingBottom="0dp">

            <!-- Title: {User name}'s Hearing Profile -->
            <TextView
                android:id="@+id/profileTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Hearing Profile"
                android:textSize="24sp"
                android:textColor="@android:color/black"
                android:textStyle="bold"
                android:fontFamily="@font/poppins"
                android:gravity="start"
                android:layout_marginBottom="24dp" />

            <!-- Audiogram Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp"
                app:cardUseCompatPadding="true"
                app:contentPadding="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Pure Tone Audiogram"
                        android:textSize="18sp"
                        android:textColor="@color/primary"
                        android:textStyle="bold"
                        android:fontFamily="@font/poppins"
                        android:layout_marginBottom="8dp" />

                    <!-- Audiogram View -->
                    <com.audion.app.views.AudiogramView
                        android:id="@+id/audiogramView"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:padding="32dp" />

                    <!-- Legend -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center"
                        android:layout_marginTop="8dp">

                        <!-- Left Ear Legend -->
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginEnd="24dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="X Left Ear"
                                android:textSize="14sp"
                                android:textColor="#4285F4"
                                android:fontFamily="@font/poppins" />
                        </LinearLayout>

                        <!-- Right Ear Legend -->
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="O Right Ear"
                                android:textSize="14sp"
                                android:textColor="#EA4335"
                                android:fontFamily="@font/poppins" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Test Date Info -->
            <TextView
                android:id="@+id/testDateText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Last test: Not available"
                android:textSize="14sp"
                android:textColor="@android:color/darker_gray"
                android:fontFamily="@font/poppins"
                android:gravity="center"
                android:layout_marginTop="8dp" />

            <!-- Delete Profile Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDeleteProfile"
                style="@style/Widget.Material3.Button"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="Delete Profile &amp; All Data"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:fontFamily="@font/poppins"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="16dp"
                app:cornerRadius="12dp"
                app:backgroundTint="#DC3545"
                app:icon="@android:drawable/ic_menu_delete"
                app:iconGravity="textStart"
                app:iconTint="#FFFFFF" />

        </LinearLayout>

    <include
        android:id="@+id/bottomNavigationView"
        layout="@layout/bottom_navigation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true" />

</RelativeLayout>
