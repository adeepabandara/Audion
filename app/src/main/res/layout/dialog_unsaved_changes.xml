<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="@drawable/dialog_rounded_background"
    android:layout_marginStart="8dp"
    android:layout_marginEnd="8dp"
    android:layout_gravity="center">

    <!-- Title -->
    <TextView
        android:id="@+id/dialogTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Unsaved Changes"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="#000000"
        android:gravity="center"
        android:layout_marginBottom="8dp"/>

    <!-- Description -->
    <TextView
        android:id="@+id/dialogDescription"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="You have unsaved changes to your frequency settings. What would you like to do?"
        android:textSize="13sp"
        android:textColor="#000000"
        android:lineSpacingExtra="2dp"
        android:gravity="center"
        android:layout_marginBottom="20dp"/>

    <!-- Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center">

        <!-- Save Button (Primary) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDialogSave"
            style="@style/Widget.Material3.Button"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="Save Changes"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="8dp"
            app:cornerRadius="8dp"
            app:backgroundTint="@color/primary"/>

        <!-- Discard Button (Secondary) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDialogDiscard"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="Discard Changes"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/text_secondary"
            app:cornerRadius="8dp"
            app:strokeColor="@color/text_secondary"
            app:strokeWidth="1dp"/>

    </LinearLayout>

</LinearLayout>
