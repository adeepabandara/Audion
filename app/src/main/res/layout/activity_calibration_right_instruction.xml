<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"        
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="24dp"
    android:background="#F0FDFA">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <TextView
            android:id="@+id/instructionTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Right Ear Calibration"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="#1A6958"
            android:layout_marginTop="32dp"/>

        <TextView
            android:id="@+id/instructionBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Now we’ll repeat the three-level test for your right ear."
            android:textSize="16sp"
            android:textColor="#475057"
            android:layout_marginTop="16dp"
            android:lineSpacingExtra="4dp"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonStartRightCalibration"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="I’m Ready"
            android:textAllCaps="false"
            android:layout_marginTop="48dp"
            app:cornerRadius="24dp"                           
            android:backgroundTint="#0F766E"
            android:textColor="#FFFFFF"/>
    </LinearLayout>
</ScrollView>
