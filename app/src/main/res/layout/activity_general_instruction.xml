<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F0FDFA"
    android:fillViewport="true"
    android:padding="20dp">

    <!-- Outer container centers the inner fixed-width container horizontally -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <!-- Inner fixed-width container preserving original styling (319dp width) -->
        <LinearLayout
            android:layout_width="319dp"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Logo Section -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingBottom="4dp"/>

            <!-- Greeting Text -->
            <TextView
                android:id="@+id/tvGreeting"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:text="let’s get started!"
                android:textColor="#1A6958"
                android:textSize="32sp"
                android:textStyle="bold" />

            <!-- Introduction Text -->
            <TextView
                android:id="@+id/tvIntro"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:fontFamily="@font/poppins"
                android:lineSpacingExtra="4dp"
                android:text="We’ll run a quick Pure Tone Hearing Test to fine-tune Audion just for you. Find a quiet space, grab your headphones."
                android:textColor="#4A4A4A"
                android:textSize="14sp" />

            <!-- Follow-Up Instruction -->
            <TextView
                android:id="@+id/tvFollowUp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                android:fontFamily="@font/poppins"
                android:text="To proceed, please connect wired or Bluetooth headphones"
                android:textColor="#4A4A4A"
                android:textSize="14sp" />

            <!-- Ear Image -->
            <ImageView
                android:id="@+id/imageViewEar"
                android:layout_width="330dp"
                android:layout_height="245dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ear" />

            <!-- Spacer to push button to bottom -->
            <View
                android:layout_width="match_parent"
                android:layout_height="30dp"
                android:layout_weight="1" />

            <!-- Ready Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonProceed"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="16dp"
                android:backgroundTint="#0F766E"
                android:fontFamily="@font/poppins_light"
                android:text="I’m Ready – Let’s Begin!"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"
                app:cornerRadius="20dp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
