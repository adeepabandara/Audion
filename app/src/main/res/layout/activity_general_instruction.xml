<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F0FDFA"
    android:fillViewport="true"
    android:padding="20dp">

    <!-- Now fills the screen so our spacer can push the button down -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Logo Section (if any) -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingBottom="4dp" />

        <!-- Greeting Text -->
        <TextView
            android:id="@+id/tvGreeting"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text="let’s get started!"
            android:textColor="#1A6958"
            android:textSize="32sp"
            android:textStyle="bold" />

        <!-- Introduction Text -->
        <TextView
            android:id="@+id/tvIntro"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:fontFamily="@font/poppins"
            android:lineSpacingExtra="4dp"
            android:text="We’ll run a quick Pure Tone Hearing Test to fine-tune Audion just for you. Find a quiet space, grab your headphones."
            android:textColor="#4A4A4A"
            android:textSize="14sp" />

        <!-- Follow-Up Instruction -->
        <TextView
            android:id="@+id/tvFollowUp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:fontFamily="@font/poppins"
            android:text="To proceed, please connect wired or Bluetooth headphones"
            android:textColor="#4A4A4A"
            android:textSize="14sp" />

        <!-- Ear Image -->
        <ImageView
            android:id="@+id/imageViewEar"
            android:layout_width="match_parent"
            android:layout_height="275dp"
            android:layout_marginBottom="20dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ear" />

        <!-- This spacer consumes all extra space, pushing the button to the bottom -->
        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Proceed Button pinned at the bottom -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonProceed"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginBottom="16dp"
            android:backgroundTint="#0F766E"
            android:fontFamily="@font/poppins_light"
            android:text="I’m Ready – Let’s Begin!"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            app:cornerRadius="20dp" />

    </LinearLayout>
</ScrollView>
