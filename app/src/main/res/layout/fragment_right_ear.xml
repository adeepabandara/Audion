<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rightEarScrollView"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:id="@+id/layoutRightEarContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#F0FDFA">

        <!-- Card container for all eight sliders -->
        <LinearLayout
            android:id="@+id/cardRightEarSliders"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/rounded_mint_card"
            android:padding="16dp"
            android:layout_marginBottom="16dp">

            <include
                android:id="@+id/row125HzRight"
                layout="@layout/row_frequency_slider" />
            <include
                android:id="@+id/row250HzRight"
                layout="@layout/row_frequency_slider" />
            <include
                android:id="@+id/row500HzRight"
                layout="@layout/row_frequency_slider" />
            <include
                android:id="@+id/row1000HzRight"
                layout="@layout/row_frequency_slider" />
            <include
                android:id="@+id/row2000HzRight"
                layout="@layout/row_frequency_slider" />
            <include
                android:id="@+id/row3000HzRight"
                layout="@layout/row_frequency_slider" />
            <include
                android:id="@+id/row4000HzRight"
                layout="@layout/row_frequency_slider" />
            <include
                android:id="@+id/row8000HzRight"
                layout="@layout/row_frequency_slider" />

        </LinearLayout>

        <!-- Save button, hidden until user changes any slider -->
        <Button
            android:id="@+id/btnSaveRightEar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Save Changes"
            android:visibility="gone"
            android:layout_gravity="center_horizontal"/>
    </LinearLayout>
</ScrollView>
