<?xml version="1.0" encoding="utf-8"?>
<ScrollView 
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F0FDFA"
    android:padding="20dp">
    
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal">
        
        <!-- Toggle Button with exact previous styling -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/toggleButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Start" />
        
        <!-- Amplification SeekBar -->
        <SeekBar
            android:id="@+id/amplificationSeekBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
        
        <!-- Noise Removal Switch -->
        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/noiseRemovalSwitch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Noise Cancellation" />
        
        <!-- Profile Info TextView -->
        <TextView
            android:id="@+id/tvSelectedProfile"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Profile Name" />
        
        <!-- Profile Icon ImageView -->
        <ImageView
            android:id="@+id/ivProfileIcon"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_home" />
        
        <!-- Include any further legacy UI elements exactly as you had them -->
        
    </LinearLayout>
</ScrollView>