<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp">

    <!-- Close Button with Grey Circle Background -->
    <FrameLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:layout_marginBottom="8dp">
        
        <View
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="@drawable/circle_grey_background" />
        
        <ImageButton
            android:id="@+id/btnClose"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            android:scaleType="centerInside"
            android:padding="6dp"
            android:tint="@color/text_secondary"
            android:contentDescription="Close" />
    </FrameLayout>

    <!-- Connect GIF Image -->
    <pl.droidsonroids.gif.GifImageView
        android:id="@+id/connectGif"
        android:layout_width="200dp"
        android:layout_height="200dp"
        android:layout_gravity="center"
        android:scaleType="fitCenter"
        android:src="@drawable/connect"
        android:contentDescription="Connect earbuds illustration" />

    <!-- Title -->
    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="Earbuds Required"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="@android:color/black"
        android:fontFamily="@font/poppins"
        android:gravity="center" />

    <!-- Description -->
    <TextView
        android:id="@+id/tvDescription"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Please connect your wired or wireless earphone to continue"
        android:textSize="16sp"
        android:textColor="#6B7280"
        android:fontFamily="@font/poppins"
        android:gravity="center"
        android:lineSpacingExtra="4dp" />

    <!-- Checking Status Text (Optional) -->
    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="Checking for audio devices..."
        android:textSize="14sp"
        android:textColor="@color/primary"
        android:fontFamily="@font/poppins"
        android:gravity="center"
        android:textStyle="italic" />

</LinearLayout>
