<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_pastel_gradient"
    android:fitsSystemWindows="true"
    android:paddingHorizontal="@dimen/onboarding_horizontal_padding">

    <!-- Main Title: What's your name? -->
    <TextView
        android:id="@+id/tvMainTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/onboarding_title_margin_top"
        android:fontFamily="sans-serif"
        android:text="What's your"
        android:textColor="@color/onboarding_text_primary"
        android:textSize="@dimen/onboarding_main_title_size"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Name -->
    <TextView
        android:id="@+id/tvName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif"
        android:lineSpacingExtra="@dimen/onboarding_title_line_spacing"
        android:text="Name?"
        android:textColor="@color/onboarding_text_primary"
        android:textSize="@dimen/onboarding_bold_title_size"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvMainTitle" />

    <!-- Description -->
    <TextView
        android:id="@+id/tvDescription"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/onboarding_spacing_title_to_paragraph"
        android:fontFamily="sans-serif"
        android:lineSpacingExtra="@dimen/onboarding_paragraph_line_spacing"
        android:maxWidth="@dimen/onboarding_paragraph_max_width"
        android:text="Tell us your name so we can personalize your hearing experience and keep track of your progress."
        android:textColor="@color/onboarding_text_secondary"
        android:textSize="@dimen/onboarding_paragraph_size"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvName"
        app:layout_constraintWidth_max="@dimen/onboarding_paragraph_max_width" />

    <!-- Name Input -->
    <EditText
        android:id="@+id/editTextName"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_marginTop="32dp"
        android:background="@drawable/onboarding_button_bg"
        android:hint="Enter your name"
        android:padding="16dp"
        android:textColor="@color/onboarding_text_primary"
        android:textColorHint="@color/onboarding_text_secondary"
        android:textSize="16sp"
        android:fontFamily="sans-serif"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvDescription" />

    <!-- Continue Button -->
    <Button
        android:id="@+id/buttonSubmit"
        android:layout_width="0dp"
        android:layout_height="@dimen/onboarding_button_height"
        android:layout_marginBottom="@dimen/onboarding_spacing_indicators_to_button"
        android:background="@drawable/onboarding_button_bg"
        android:fontFamily="sans-serif"
        android:text="Let's get started"
        android:textAllCaps="false"
        android:textColor="@color/onboarding_button_text"
        android:textSize="@dimen/onboarding_button_text_size"
        android:textStyle="normal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
