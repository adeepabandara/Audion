<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <!-- Title for Quick Guides -->
    <TextView
        android:id="@+id/tvQuickGuidesTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Quick Guides"
        android:textColor="@color/primary"
        android:textSize="20sp"
        android:layout_margin="16dp" />

    <!-- Horizontal separator -->
    <View
        android:id="@+id/divider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/outline"
        android:layout_below="@id/tvQuickGuidesTitle"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="8dp" />

    <!-- Container for Quick Guide cards -->
    <ScrollView
        android:id="@+id/quickGuidesScroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/divider"
        android:padding="16dp">

        <LinearLayout
            android:id="@+id/quickGuidesContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- 1. Play Button Card -->
            <LinearLayout
                android:id="@+id/guideCard1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/rounded_mint_card"
                android:padding="16dp"
                android:orientation="vertical"
                android:layout_marginBottom="8dp"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:id="@+id/guideTitle1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Play Button"
                    android:textColor="@color/primary"
                    android:textSize="18sp" />

                <TextView
                    android:id="@+id/guideDesc1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="How to start/stop audio streaming"
                    android:textColor="@color/primary"
                    android:textSize="14sp"
                    android:maxLines="2"
                    android:ellipsize="end" />
            </LinearLayout>

            <!-- 2. Amplification Card -->
            <LinearLayout
                android:id="@+id/guideCard2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/rounded_mint_card"
                android:padding="16dp"
                android:orientation="vertical"
                android:layout_marginBottom="8dp"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:id="@+id/guideTitle2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Amplification"
                    android:textColor="@color/primary"
                    android:textSize="18sp" />

                <TextView
                    android:id="@+id/guideDesc2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Adjust the amplification level"
                    android:textColor="@color/primary"
                    android:textSize="14sp"
                    android:maxLines="2"
                    android:ellipsize="end" />
            </LinearLayout>

            <!-- 3. Noise Cancellation Card -->
            <LinearLayout
                android:id="@+id/guideCard3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/rounded_mint_card"
                android:padding="16dp"
                android:orientation="vertical"
                android:layout_marginBottom="8dp"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:id="@+id/guideTitle3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Noise Cancellation"
                    android:textColor="@color/primary"
                    android:textSize="18sp" />

                <TextView
                    android:id="@+id/guideDesc3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Toggle noise removal on/off"
                    android:textColor="@color/primary"
                    android:textSize="14sp"
                    android:maxLines="2"
                    android:ellipsize="end" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- FAQs Section Title -->
    <TextView
        android:id="@+id/tvFaqTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="FAQs"
        android:textColor="@color/primary"
        android:textSize="20sp"
        android:layout_below="@id/quickGuidesScroll"
        android:layout_margin="16dp" />

    <!-- FAQ RecyclerView -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/faqRecyclerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/tvFaqTitle"
        android:layout_above="@id/bottomNavigationView"
        android:paddingStart="16dp"
        android:paddingEnd="16dp" />

    <!-- Bottom Navigation include -->
    <include
        android:id="@+id/bottomNavigationView"
        layout="@layout/bottom_navigation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true" />

</RelativeLayout>
