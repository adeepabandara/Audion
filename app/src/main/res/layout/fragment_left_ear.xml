<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/leftEarScrollView"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    >

    <LinearLayout
        android:id="@+id/layoutLeftEarContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- All sliders live inside this mint‑card container -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/rounded_mint_card"
            android:layout_marginBottom="16dp">

            <!-- 8 frequency rows -->
            <include layout="@layout/row_frequency_slider" android:id="@+id/row125Hz" />
            <include layout="@layout/row_frequency_slider" android:id="@+id/row250Hz" />
            <include layout="@layout/row_frequency_slider" android:id="@+id/row500Hz" />
            <include layout="@layout/row_frequency_slider" android:id="@+id/row1000Hz" />
            <include layout="@layout/row_frequency_slider" android:id="@+id/row2000Hz" />
            <include layout="@layout/row_frequency_slider" android:id="@+id/row3000Hz" />
            <include layout="@layout/row_frequency_slider" android:id="@+id/row4000Hz" />
            <include layout="@layout/row_frequency_slider" android:id="@+id/row8000Hz" />

        </LinearLayout>

        <!-- Save button at bottom -->
        <Button
            android:id="@+id/btnSaveLeftEar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Save Changes"
            android:layout_marginTop="8dp"
            android:layout_gravity="center_horizontal"/>

    </LinearLayout>
</ScrollView>
