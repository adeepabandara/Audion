<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/layoutLeftEarContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- Card container for all frequency sliders - no ScrollView -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardLeftEarSliders"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        app:cardCornerRadius="10dp"
        app:cardElevation="4dp"
        app:strokeWidth="0dp"
        app:cardBackgroundColor="@android:color/white">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="8dp">

            <include
                android:id="@+id/row125Hz"
                layout="@layout/row_frequency_slider"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />
            <include
                android:id="@+id/row250Hz"
                layout="@layout/row_frequency_slider"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />
            <include
                android:id="@+id/row500Hz"
                layout="@layout/row_frequency_slider"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />
            <include
                android:id="@+id/row1000Hz"
                layout="@layout/row_frequency_slider"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />
            <include
                android:id="@+id/row2000Hz"
                layout="@layout/row_frequency_slider"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />
            <include
                android:id="@+id/row3000Hz"
                layout="@layout/row_frequency_slider"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />
            <include
                android:id="@+id/row4000Hz"
                layout="@layout/row_frequency_slider"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />
            <include
                android:id="@+id/row8000Hz"
                layout="@layout/row_frequency_slider"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</LinearLayout>
